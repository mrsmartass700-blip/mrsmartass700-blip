  <Item class="StarterPlayer" referent="22">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CharacterWalkSpeed">18</float>
    </Properties>
    <Item class="StarterPlayerScripts" referent="23">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="24">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Hud</string>
            <string name="Source"><![CDATA[-- Always-visible HUD: cash, income, backpack, event banner and side menu.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Format = require(Shared.Format)

local Ui = require(script.Parent.Ui)

local player = Players.LocalPlayer

local Hud = {}

export type Callbacks = {
	OnShop: () -> (),
	OnRebirth: () -> (),
	OnHome: () -> (),
}

local function sideButton(
	parent: Instance,
	icon: string,
	text: string,
	color: Color3,
	order: number,
	callback: () -> ()
)
	local button = Ui.new("TextButton", {
		Name = text,
		Size = UDim2.fromOffset(74, 74),
		BackgroundColor3 = color,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = order,
		Parent = parent,
	}, {
		Ui.corner(16),
		Ui.stroke(Color3.new(0, 0, 0), 2.5),
		Ui.gradient(Color3.new(1, 1, 1), Color3.fromRGB(185, 185, 185)),
	})
	Ui.label({
		Size = UDim2.fromScale(1, 0.62),
		Position = UDim2.fromScale(0, 0.04),
		Text = icon,
		MaxTextSize = 36,
		Parent = button,
	})
	Ui.label({
		Size = UDim2.new(1, -6, 0.3, 0),
		Position = UDim2.new(0, 3, 0.66, 0),
		Text = text,
		TextStrokeTransparency = 0.3,
		MaxTextSize = 16,
		Parent = button,
	})
	local scale = Ui.new("UIScale", { Parent = button })
	button.MouseEnter:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1.08 }):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1 }):Play()
	end)
	button.Activated:Connect(callback)
	return button
end

function Hud.mount(screen: ScreenGui, callbacks: Callbacks)
	-- Cash --------------------------------------------------------------
	local cashPanel = Ui.new("Frame", {
		Name = "Cash",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(300, 64),
		BackgroundColor3 = Ui.Colors.Panel,
		BackgroundTransparency = 0.08,
		Parent = screen,
	}, {
		Ui.corner(16),
		Ui.stroke(Ui.Colors.Cash, 2.5),
	})
	local cashLabel = Ui.label({
		Size = UDim2.new(1, -16, 0.62, 0),
		Position = UDim2.fromOffset(8, 4),
		Text = "💰 $0",
		TextColor3 = Ui.Colors.Cash,
		TextStrokeTransparency = 0.3,
		MaxTextSize = 34,
		Parent = cashPanel,
	})
	local incomeLabel = Ui.label({
		Size = UDim2.new(1, -16, 0.3, 0),
		Position = UDim2.new(0, 8, 0.64, 0),
		Text = "+$0/s",
		TextColor3 = Ui.Colors.Muted,
		MaxTextSize = 18,
		Parent = cashPanel,
	})
	local cashScale = Ui.new("UIScale", { Parent = cashPanel })

	local lastCash = 0
	local function updateCash()
		local cash = player:GetAttribute("Cash") or 0
		cashLabel.Text = "💰 " .. Format.money(cash)
		if cash > lastCash then
			cashScale.Scale = 1.08
			TweenService:Create(cashScale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		end
		lastCash = cash
	end
	local function updateIncome()
		local income = player:GetAttribute("IncomePerSec") or 0
		local stored = player:GetAttribute("Stored") or 0
		local text = "+" .. Format.perSecond(income)
		if stored >= 1 then
			text ..= '  <font color="#ffd966">• ' .. Format.money(stored) .. " in register</font>"
		end
		incomeLabel.Text = text
	end
	player:GetAttributeChangedSignal("Cash"):Connect(updateCash)
	player:GetAttributeChangedSignal("IncomePerSec"):Connect(updateIncome)
	player:GetAttributeChangedSignal("Stored"):Connect(updateIncome)
	updateCash()
	updateIncome()

	-- Witching Hour banner ---------------------------------------------
	local banner = Ui.new("Frame", {
		Name = "EventBanner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 78),
		Size = UDim2.fromOffset(360, 34),
		BackgroundColor3 = Color3.fromRGB(90, 20, 90),
		Visible = false,
		Parent = screen,
	}, {
		Ui.corner(12),
		Ui.stroke(Color3.fromRGB(255, 120, 255), 2),
	})
	local bannerLabel = Ui.label({
		Size = UDim2.new(1, -12, 1, -6),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = "",
		MaxTextSize = 20,
		Parent = banner,
	})
	task.spawn(function()
		while true do
			local active = ReplicatedStorage:GetAttribute("WitchingHour") == true
			banner.Visible = active
			if active then
				local left = (ReplicatedStorage:GetAttribute("WitchingHourEndsAt") or 0) - workspace:GetServerTimeNow()
				bannerLabel.Text = "🌕 WITCHING HOUR • Rare ghosts x3 • " .. Format.time(left)
			end
			task.wait(0.5)
		end
	end)

	-- Side menu ----------------------------------------------------------
	local menu = Ui.new("Frame", {
		Name = "Menu",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.5, 0),
		Size = UDim2.fromOffset(74, 250),
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		Ui.new("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 10),
			VerticalAlignment = Enum.VerticalAlignment.Center,
		}),
	})
	sideButton(menu, "🛒", "Shop", Ui.Colors.Gold, 1, callbacks.OnShop)
	sideButton(menu, "♻️", "Rebirth", Ui.Colors.Purple, 2, callbacks.OnRebirth)
	sideButton(menu, "🏨", "Hotel", Ui.Colors.Blue, 3, callbacks.OnHome)

	-- Backpack / vacuum ---------------------------------------------------
	local bag = Ui.new("Frame", {
		Name = "Backpack",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -86),
		Size = UDim2.fromOffset(290, 40),
		BackgroundColor3 = Ui.Colors.Panel,
		BackgroundTransparency = 0.12,
		Parent = screen,
	}, {
		Ui.corner(12),
		Ui.stroke(Ui.Colors.Stroke, 2),
	})
	local bagLabel = Ui.label({
		Size = UDim2.new(1, -16, 1, -8),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = "",
		MaxTextSize = 22,
		Parent = bag,
	})
	local hint = Ui.label({
		Name = "Hint",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -132),
		Size = UDim2.fromOffset(460, 30),
		Text = "",
		TextColor3 = Color3.fromRGB(255, 240, 150),
		TextStrokeTransparency = 0.2,
		MaxTextSize = 22,
		Parent = screen,
	})

	local function updateBag()
		local count = player:GetAttribute("BackpackCount") or 0
		local capacity = player:GetAttribute("BackpackCapacity") or 0
		local power = player:GetAttribute("VacuumPower") or 1
		local color = if capacity > 0 and count >= capacity then "#ff8080" else "#ffffff"
		bagLabel.Text =
			string.format('🎒 <font color="%s">%d/%d</font>   🌀 Power x%.2f', color, count, capacity, power)
		local caught = player:GetAttribute("Caught") or 0
		if caught == 0 then
			hint.Text = "👻 Go to the graveyard and HOLD click near a ghost to vacuum it!"
		elseif capacity > 0 and count >= capacity then
			hint.Text = "🎒 Backpack full! Walk into your hotel to check the ghosts in."
		elseif caught < 4 and count > 0 then
			hint.Text = "🏨 Walk into your hotel to check ghosts in. Collect cash at the green register!"
		else
			hint.Text = ""
		end
	end
	for _, attribute in { "BackpackCount", "BackpackCapacity", "VacuumPower", "Caught" } do
		player:GetAttributeChangedSignal(attribute):Connect(updateBag)
	end
	updateBag()
end

return Hud
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="26">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Client entry point: builds the UI and hooks up remotes.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Hud = require(script.Parent.Hud)
local Notifications = require(script.Parent.Notifications)
local RebirthPanel = require(script.Parent.RebirthPanel)
local Shop = require(script.Parent.Shop)
local WorldEffects = require(script.Parent.WorldEffects)

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")

local screen = Instance.new("ScreenGui")
screen.Name = "HotelUI"
screen.ResetOnSpawn = false
screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screen.Parent = player:WaitForChild("PlayerGui")

Notifications.mount(screen)
local shop = Shop.mount(screen)
local rebirth = RebirthPanel.mount(screen)

Hud.mount(screen, {
	OnShop = function()
		shop:toggle()
	end,
	OnRebirth = function()
		rebirth:toggle()
	end,
	OnHome = function()
		remotes.TeleportHome:FireServer()
	end,
})

remotes:WaitForChild("Notify").OnClientEvent:Connect(function(text: string, kind: string?)
	Notifications.show(text, kind)
	if kind == "error" then
		WorldEffects.playSound("error")
	elseif kind == "rare" or kind == "event" then
		WorldEffects.playSound("rare")
	end
end)

WorldEffects.start()
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Notifications</string>
            <string name="Source"><![CDATA[-- Toast notifications stacked under the cash display.

local TweenService = game:GetService("TweenService")

local Ui = require(script.Parent.Ui)

local Notifications = {}

local MAX_TOASTS = 5
local LIFETIME = 4.5

local KIND_COLORS = {
	info = Ui.Colors.Purple,
	success = Ui.Colors.Green,
	error = Ui.Colors.Red,
	event = Ui.Colors.Gold,
	rare = Color3.fromRGB(255, 90, 220),
}

local container: Frame

function Notifications.mount(screen: ScreenGui)
	container = Ui.new("Frame", {
		Name = "Notifications",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 118),
		Size = UDim2.new(0.9, 0, 0, 260),
		Parent = screen,
	}, {
		Ui.new("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 6),
		}),
		Ui.new("UISizeConstraint", { MaxSize = Vector2.new(520, math.huge) }),
	})
end

local order = 0

function Notifications.show(text: string, kind: string?)
	if not container then
		return
	end
	order += 1
	local color = KIND_COLORS[kind or "info"] or KIND_COLORS.info

	local toast = Ui.new("Frame", {
		Name = "Toast",
		BackgroundColor3 = Ui.Colors.Panel,
		BackgroundTransparency = 0.1,
		Size = UDim2.new(1, 0, 0, 40),
		LayoutOrder = order,
		Parent = container,
	}, {
		Ui.corner(10),
		Ui.stroke(color, 2),
	})
	local label = Ui.label({
		Size = UDim2.new(1, -20, 1, -8),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = text,
		TextColor3 = if kind == "error" then Color3.fromRGB(255, 190, 190) else Ui.Colors.Text,
		MaxTextSize = 22,
		Parent = toast,
	})
	local scale = Ui.new("UIScale", { Scale = 0.6, Parent = toast })
	TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()

	local toasts = {}
	for _, child in container:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	table.sort(toasts, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	while #toasts > MAX_TOASTS do
		table.remove(toasts, 1):Destroy()
	end

	task.delay(LIFETIME, function()
		if not toast.Parent then
			return
		end
		local fade = TweenInfo.new(0.35)
		TweenService:Create(toast, fade, { BackgroundTransparency = 1 }):Play()
		TweenService:Create(label, fade, { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		local stroke = toast:FindFirstChildOfClass("UIStroke")
		if stroke then
			TweenService:Create(stroke, fade, { Transparency = 1 }):Play()
		end
		task.wait(0.4)
		toast:Destroy()
	end)
end

return Notifications
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Panel</string>
            <string name="Source"><![CDATA[-- Reusable modal window with a title bar, close button and scrolling body.
-- Only one panel is open at a time.

local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Ui = require(script.Parent.Ui)

local Panel = {}
Panel.__index = Panel

export type Panel = {
	Frame: Frame,
	Content: ScrollingFrame,
	Opened: RBXScriptSignal,
	IsOpen: boolean,
	open: (self: Panel) -> (),
	close: (self: Panel) -> (),
	toggle: (self: Panel) -> (),
}

local current = nil

function Panel.new(screen: ScreenGui, title: string, accent: Color3)
	local frame = Ui.new("Frame", {
		Name = title,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromScale(0.92, 0.8),
		BackgroundColor3 = Ui.Colors.Panel,
		Visible = false,
		Parent = screen,
	}, {
		Ui.corner(20),
		Ui.stroke(accent, 3),
		Ui.new("UISizeConstraint", { MaxSize = Vector2.new(660, 540) }),
	})
	local scale = Ui.new("UIScale", { Parent = frame })

	Ui.label({
		Size = UDim2.new(1, -120, 0, 44),
		Position = UDim2.fromOffset(18, 10),
		Text = title,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = accent,
		MaxTextSize = 34,
		Parent = frame,
	})

	local closeButton = Ui.button({
		Size = UDim2.fromOffset(44, 44),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 10),
		Text = "✕",
		Color = Ui.Colors.Red,
		Parent = frame,
	})

	local content = Ui.new("ScrollingFrame", {
		Name = "Content",
		Position = UDim2.fromOffset(14, 64),
		Size = UDim2.new(1, -28, 1, -78),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = accent,
		Parent = frame,
	}, {
		Ui.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 10) }),
		Ui.new("UIPadding", { PaddingRight = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10) }),
	})

	local opened = Instance.new("BindableEvent")
	local self = setmetatable({
		Frame = frame,
		Content = content,
		Opened = opened.Event,
		IsOpen = false,
		_opened = opened,
		_scale = scale,
	}, Panel)

	closeButton.Activated:Connect(function()
		self:close()
	end)

	return self
end

function Panel:open()
	if current and current ~= self then
		current:close()
	end
	current = self
	self.IsOpen = true
	self.Frame.Visible = true
	local camera = Workspace.CurrentCamera
	local fit = if camera then math.clamp(camera.ViewportSize.Y / 640, 0.6, 1) else 1
	self._scale.Scale = fit * 0.85
	TweenService:Create(self._scale, TweenInfo.new(0.2, Enum.EasingStyle.Back), { Scale = fit }):Play()
	self._opened:Fire()
end

function Panel:close()
	self.IsOpen = false
	self.Frame.Visible = false
	if current == self then
		current = nil
	end
end

function Panel:toggle()
	if self.IsOpen then
		self:close()
	else
		self:open()
	end
end

return Panel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">RebirthPanel</string>
            <string name="Source"><![CDATA[-- Rebirth window: shows the cost, what you keep and what you gain.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)

local Panel = require(script.Parent.Panel)
local Ui = require(script.Parent.Ui)

local player = Players.LocalPlayer

local RebirthPanel = {}

function RebirthPanel.mount(screen: ScreenGui)
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local panel = Panel.new(screen, "♻️ REBIRTH", Ui.Colors.Purple)
	local list = panel.Content

	local function row(order: number, height: number, color: Color3?): TextLabel
		return Ui.label({
			Size = UDim2.new(1, 0, 0, height),
			Text = "",
			TextColor3 = color or Ui.Colors.Text,
			TextWrapped = true,
			MaxTextSize = 24,
			LayoutOrder = order,
			Parent = list,
		})
	end

	local status = row(1, 40)
	local gains = row(2, 90, Ui.Colors.Cash)
	local warning = row(3, 60, Color3.fromRGB(255, 170, 170))
	warning.Text =
		"⚠️ Resets your cash, ghosts, rooms, upgrades and hotel builds.\nRebirths and game passes are kept."

	local progressBack = Ui.new("Frame", {
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundColor3 = Color3.fromRGB(20, 14, 30),
		LayoutOrder = 4,
		Parent = list,
	}, { Ui.corner(13) })
	local progressFill = Ui.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Ui.Colors.Purple,
		Parent = progressBack,
	}, { Ui.corner(13) })
	local progressText = Ui.label({
		Size = UDim2.fromScale(1, 1),
		Text = "",
		MaxTextSize = 18,
		Parent = progressBack,
	})

	local button = Ui.button({
		Size = UDim2.new(1, 0, 0, 60),
		Text = "REBIRTH",
		Color = Ui.Colors.Purple,
		MaxTextSize = 32,
		LayoutOrder = 5,
		Parent = list,
	})

	local function refresh()
		local rebirths = player:GetAttribute("Rebirths") or 0
		local cash = player:GetAttribute("Cash") or 0
		local cost = Formulas.rebirthCost(rebirths)
		status.Text = "Rebirths: " .. rebirths .. "   •   Cost: " .. Format.money(cost)
		gains.Text = string.format(
			"✅ +%d%% income forever (x%.1f → x%.1f)\n✅ +%d%% vacuum power forever",
			Config.Rebirth.IncomeBonus * 100,
			1 + rebirths * Config.Rebirth.IncomeBonus,
			1 + (rebirths + 1) * Config.Rebirth.IncomeBonus,
			Config.Rebirth.VacuumBonus * 100
		)
		local ratio = math.clamp(cash / cost, 0, 1)
		progressFill.Size = UDim2.fromScale(ratio, 1)
		progressText.Text = Format.money(cash) .. " / " .. Format.money(cost)
		local ready = cash >= cost
		button.BackgroundColor3 = if ready then Ui.Colors.Purple else Ui.Colors.Grey
		Ui.setButtonText(button, if ready then "♻️ REBIRTH NOW" else "Not enough cash")
	end

	button.Activated:Connect(function()
		local cost = Formulas.rebirthCost(player:GetAttribute("Rebirths") or 0)
		if (player:GetAttribute("Cash") or 0) >= cost then
			remotes.Rebirth:FireServer()
			panel:close()
		end
	end)

	player:GetAttributeChangedSignal("Cash"):Connect(function()
		if panel.IsOpen then
			refresh()
		end
	end)
	player:GetAttributeChangedSignal("Rebirths"):Connect(refresh)
	panel.Opened:Connect(refresh)
	refresh()

	return panel
end

return RebirthPanel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Shop</string>
            <string name="Source"><![CDATA[-- Robux shop: game passes, cash packs and the Witching Hour (with odds).

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)
local Odds = require(Shared.Odds)

local Notifications = require(script.Parent.Notifications)
local Panel = require(script.Parent.Panel)
local Ui = require(script.Parent.Ui)

local player = Players.LocalPlayer

local Shop = {}

local priceCache: { [string]: number } = {}

local function getIds(): Instance?
	return ReplicatedStorage:FindFirstChild("MonetizationIds")
end

local function getId(kind: string, key: string): number
	local ids = getIds()
	return if ids then ids:GetAttribute(kind .. "_" .. key) or 0 else 0
end

local function fetchPrice(kind: string, id: number, callback: (number) -> ())
	local cacheKey = kind .. id
	if priceCache[cacheKey] then
		callback(priceCache[cacheKey])
		return
	end
	task.spawn(function()
		local ok, info = pcall(function()
			local infoType = if kind == "Pass" then Enum.InfoType.GamePass else Enum.InfoType.Product
			return MarketplaceService:GetProductInfoAsync(id, infoType)
		end)
		if ok and info and info.PriceInRobux then
			priceCache[cacheKey] = info.PriceInRobux
			callback(info.PriceInRobux)
		end
	end)
end

local function sectionTitle(parent: Instance, text: string, order: number)
	Ui.label({
		Size = UDim2.new(1, 0, 0, 34),
		Text = text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Ui.Colors.Gold,
		MaxTextSize = 26,
		LayoutOrder = order,
		Parent = parent,
	})
end

local function grid(parent: Instance, order: number): Frame
	return Ui.new("Frame", {
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = parent,
	}, {
		Ui.new("UIGridLayout", {
			CellSize = UDim2.new(0.5, -6, 0, 150),
			CellPadding = UDim2.fromOffset(12, 12),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
end

type CardInfo = {
	Icon: string,
	Title: string,
	Description: string,
	Order: number,
	Color: Color3,
}

local function card(parent: Instance, info: CardInfo): (Frame, TextButton, TextLabel)
	local frame = Ui.new("Frame", {
		BackgroundColor3 = Ui.Colors.PanelLight,
		LayoutOrder = info.Order,
		Parent = parent,
	}, {
		Ui.corner(14),
		Ui.stroke(info.Color, 2),
	})
	Ui.label({
		Size = UDim2.fromOffset(56, 56),
		Position = UDim2.fromOffset(8, 8),
		Text = info.Icon,
		MaxTextSize = 44,
		Parent = frame,
	})
	Ui.label({
		Size = UDim2.new(1, -76, 0, 28),
		Position = UDim2.fromOffset(70, 10),
		Text = info.Title,
		TextXAlignment = Enum.TextXAlignment.Left,
		MaxTextSize = 24,
		Parent = frame,
	})
	local description = Ui.label({
		Size = UDim2.new(1, -76, 0, 50),
		Position = UDim2.fromOffset(70, 38),
		Text = info.Description,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = Ui.Colors.Muted,
		TextWrapped = true,
		MaxTextSize = 16,
		Parent = frame,
	})
	local button = Ui.button({
		Size = UDim2.new(1, -16, 0, 44),
		Position = UDim2.new(0, 8, 1, -52),
		Text = "...",
		Color = Ui.Colors.Green,
		MaxTextSize = 24,
		Parent = frame,
	})
	return frame, button, description
end

function Shop.mount(screen: ScreenGui)
	local panel = Panel.new(screen, "🛒 SHOP", Ui.Colors.Gold)
	local list = panel.Content

	-- Game passes -------------------------------------------------------
	sectionTitle(list, "✨ Game Passes (forever)", 1)
	local passGrid = grid(list, 2)
	for index, pass in Config.GamePasses do
		local _, button = card(passGrid, {
			Icon = pass.Icon,
			Title = pass.Name,
			Description = pass.Description,
			Order = index,
			Color = Ui.Colors.Gold,
		})

		local function refresh()
			local id = getId("Pass", pass.Key)
			if player:GetAttribute("Pass_" .. pass.Key) then
				Ui.setButtonText(button, "✅ OWNED")
				button.BackgroundColor3 = Ui.Colors.Grey
			elseif id == 0 then
				Ui.setButtonText(button, "Coming soon")
				button.BackgroundColor3 = Ui.Colors.Grey
			else
				button.BackgroundColor3 = Ui.Colors.Green
				Ui.setButtonText(button, "Buy")
				fetchPrice("Pass", id, function(price)
					if not player:GetAttribute("Pass_" .. pass.Key) then
						Ui.setButtonText(button, "R$ " .. price)
					end
				end)
			end
		end
		button.Activated:Connect(function()
			local id = getId("Pass", pass.Key)
			if player:GetAttribute("Pass_" .. pass.Key) then
				return
			end
			if id == 0 then
				Notifications.show("This pass isn't set up yet.", "error")
				return
			end
			MarketplaceService:PromptGamePassPurchase(player, id)
		end)
		player:GetAttributeChangedSignal("Pass_" .. pass.Key):Connect(refresh)
		panel.Opened:Connect(refresh)
		refresh()
	end

	-- Products ------------------------------------------------------------
	sectionTitle(list, "💰 Cash & Boosts", 3)
	local productGrid = grid(list, 4)
	for index, product in Config.Products do
		local description = if product.Kind == "WitchingHour"
			then string.format(
				"Rare ghosts x%d + double spawns for EVERYONE for %s!",
				Config.WitchingHour.Luck,
				Format.time(product.Duration)
			)
			else ""
		local _, button, descriptionLabel = card(productGrid, {
			Icon = product.Icon,
			Title = product.Name,
			Description = description,
			Order = index,
			Color = if product.Kind == "WitchingHour" then Color3.fromRGB(255, 120, 255) else Ui.Colors.Cash,
		})

		local function refresh()
			if product.Kind == "Cash" then
				local amount = Formulas.cashProductAmount(product, player:GetAttribute("IncomePerSec") or 0)
				descriptionLabel.Text = '<font color="#7dff9b">+' .. Format.money(amount) .. "</font> cash instantly"
			end
			local id = getId("Product", product.Key)
			if id == 0 then
				Ui.setButtonText(button, "Coming soon")
				button.BackgroundColor3 = Ui.Colors.Grey
			else
				button.BackgroundColor3 = Ui.Colors.Green
				Ui.setButtonText(button, "Buy")
				fetchPrice("Product", id, function(price)
					Ui.setButtonText(button, "R$ " .. price)
				end)
			end
		end
		button.Activated:Connect(function()
			local id = getId("Product", product.Key)
			if id == 0 then
				Notifications.show("This item isn't set up yet.", "error")
				return
			end
			MarketplaceService:PromptProductPurchase(player, id)
		end)
		panel.Opened:Connect(refresh)
		refresh()
	end

	-- Odds disclosure -------------------------------------------------------
	sectionTitle(list, "🎲 Ghost odds (normal → Witching Hour)", 5)
	local oddsBox = Ui.new("Frame", {
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Ui.Colors.PanelLight,
		LayoutOrder = 6,
		Parent = list,
	}, {
		Ui.corner(12),
		Ui.padding(10),
		Ui.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2) }),
	})
	local normal = Odds.getChances(1)
	local boosted = Odds.getChances(Config.WitchingHour.Luck)
	for index, rarity in Config.Rarities do
		Ui.label({
			Size = UDim2.new(1, 0, 0, 22),
			Text = string.format(
				'<font color="#%s">%s</font>   %s → <font color="#ff9cff">%s</font>',
				rarity.Color:ToHex(),
				rarity.Name,
				Format.percent(normal[index]),
				Format.percent(boosted[index])
			),
			TextXAlignment = Enum.TextXAlignment.Left,
			MaxTextSize = 18,
			LayoutOrder = index,
			Parent = oddsBox,
		})
	end
	local mutationText = {}
	for _, mutation in Config.Mutations do
		table.insert(
			mutationText,
			string.format("%s %s (x%d)", mutation.Name, Format.percent(mutation.Chance * 100), mutation.Multiplier)
		)
	end
	Ui.label({
		Size = UDim2.new(1, 0, 0, 36),
		Text = "Mutations: " .. table.concat(mutationText, " • "),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Ui.Colors.Muted,
		TextWrapped = true,
		MaxTextSize = 16,
		LayoutOrder = 100,
		Parent = oddsBox,
	})

	return panel
end

return Shop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Ui</string>
            <string name="Source"><![CDATA[-- Tiny UI toolkit: instance creation + the game's visual style.

local Ui = {}

Ui.Colors = {
	Panel = Color3.fromRGB(28, 20, 44),
	PanelLight = Color3.fromRGB(46, 34, 70),
	Stroke = Color3.fromRGB(150, 100, 255),
	Text = Color3.fromRGB(255, 255, 255),
	Muted = Color3.fromRGB(190, 175, 220),
	Cash = Color3.fromRGB(120, 255, 140),
	Gold = Color3.fromRGB(255, 205, 70),
	Green = Color3.fromRGB(70, 210, 120),
	Blue = Color3.fromRGB(80, 160, 255),
	Purple = Color3.fromRGB(160, 90, 255),
	Red = Color3.fromRGB(240, 80, 90),
	Grey = Color3.fromRGB(110, 105, 125),
}

Ui.Font = Enum.Font.FredokaOne

function Ui.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className)
	local parent = nil
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			(instance :: any)[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = instance
	end
	instance.Parent = parent
	return instance
end

function Ui.corner(radius: number?): UICorner
	return Ui.new("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function Ui.stroke(color: Color3?, thickness: number?): UIStroke
	return Ui.new("UIStroke", {
		Color = color or Ui.Colors.Stroke,
		Thickness = thickness or 2,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Ui.padding(pixels: number): UIPadding
	local amount = UDim.new(0, pixels)
	return Ui.new("UIPadding", {
		PaddingTop = amount,
		PaddingBottom = amount,
		PaddingLeft = amount,
		PaddingRight = amount,
	})
end

function Ui.gradient(top: Color3, bottom: Color3): UIGradient
	return Ui.new("UIGradient", {
		Color = ColorSequence.new(top, bottom),
		Rotation = 90,
	})
end

function Ui.label(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Font = Ui.Font,
		TextColor3 = Ui.Colors.Text,
		TextScaled = true,
		RichText = true,
	}
	for key, value in props do
		if key ~= "MaxTextSize" then
			defaults[key] = value
		end
	end
	local label = Ui.new("TextLabel", defaults)
	Ui.new("UITextSizeConstraint", { MaxTextSize = props.MaxTextSize or 40, Parent = label })
	return label
end

-- Chunky game button with a darker bottom edge and a press animation.
function Ui.button(props: { [string]: any }): TextButton
	local color: Color3 = props.Color or Ui.Colors.Green
	local button = Ui.new("TextButton", {
		Name = props.Name or "Button",
		Size = props.Size or UDim2.fromOffset(160, 50),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
		BackgroundColor3 = color,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = props.LayoutOrder or 0,
		Parent = props.Parent,
	}, {
		Ui.corner(props.Radius or 12),
		Ui.stroke(Color3.new(0, 0, 0), 2),
		Ui.gradient(Color3.new(1, 1, 1), Color3.fromRGB(200, 200, 200)),
	})
	Ui.label({
		Name = "Label",
		Size = UDim2.new(1, -12, 1, -8),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Text = props.Text or "",
		TextStrokeTransparency = 0.4,
		MaxTextSize = props.MaxTextSize or 28,
		Parent = button,
	})
	local scale = Ui.new("UIScale", { Parent = button })
	button.MouseButton1Down:Connect(function()
		scale.Scale = 0.92
	end)
	button.MouseButton1Up:Connect(function()
		scale.Scale = 1
	end)
	button.MouseLeave:Connect(function()
		scale.Scale = 1
	end)
	return button
end

function Ui.setButtonText(button: TextButton, text: string)
	local label = button:FindFirstChild("Label") :: TextLabel?
	if label then
		label.Text = text
	end
end

return Ui
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">WorldEffects</string>
            <string name="Source"><![CDATA[-- Client-side juice: owner-only prompts, rainbow ghosts, bobbing room
-- ghosts, mini ghosts orbiting hunters, particle bursts, sounds and the
-- VIP chat tag.

local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TextChatService = game:GetService("TextChatService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local GhostFactory = require(Shared.GhostFactory)

local player = Players.LocalPlayer

local WorldEffects = {}

local BOB_DISTANCE = 140
local MAX_MINIS = 6

--------------------------------------------------------------------------
-- Sounds
--------------------------------------------------------------------------
local SOUNDS = {
	collect = { Id = "rbxasset://sounds/electronicpingshort.wav", Pitch = 1.25, Volume = 0.6 },
	capture = { Id = "rbxasset://sounds/swordlunge.wav", Pitch = 1.5, Volume = 0.7 },
	rare = { Id = "rbxasset://sounds/electronicpingshort.wav", Pitch = 1.7, Volume = 0.8 },
	build = { Id = "rbxasset://sounds/electronicpingshort.wav", Pitch = 0.8, Volume = 0.7 },
	error = { Id = "rbxasset://sounds/clickfast.wav", Pitch = 0.8, Volume = 0.5 },
}

function WorldEffects.playSound(name: string)
	local info = SOUNDS[name]
	if not info then
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = info.Id
	sound.PlaybackSpeed = info.Pitch
	sound.Volume = info.Volume
	sound.Parent = SoundService
	sound:Play()
	Debris:AddItem(sound, 3)
end

--------------------------------------------------------------------------
-- Particle bursts
--------------------------------------------------------------------------
local effectsFolder = Instance.new("Folder")
effectsFolder.Name = "LocalEffects"
effectsFolder.Parent = Workspace

local function burst(position: Vector3, color: Color3, count: number, speed: number)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.one
	anchor.Position = position
	anchor.Parent = effectsFolder

	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.9),
		NumberSequenceKeypoint.new(1, 0),
	})
	emitter.Speed = NumberRange.new(speed * 0.5, speed)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Lifetime = NumberRange.new(0.5, 1)
	emitter.Drag = 3
	emitter.Rate = 0
	emitter.Parent = anchor
	emitter:Emit(count)
	Debris:AddItem(anchor, 2)
end

local EFFECT_COLORS = {
	collect = Color3.fromRGB(120, 255, 140),
	checkin = Color3.fromRGB(90, 255, 220),
	build = Color3.fromRGB(255, 220, 90),
	fuse = Color3.fromRGB(190, 110, 255),
	release = Color3.fromRGB(220, 220, 255),
	rebirth = Color3.fromRGB(190, 110, 255),
	fade = Color3.fromRGB(180, 170, 210),
}

local function onEffect(kind: string, position: Vector3, rarity: number?)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local near = root ~= nil and (root.Position - position).Magnitude < 90

	if kind == "capture" then
		local color = if rarity and Config.Rarities[rarity] then Config.Rarities[rarity].Color else Color3.new(1, 1, 1)
		burst(position, color, 18 + (rarity or 1) * 6, 12)
		if near then
			WorldEffects.playSound(if rarity and rarity >= 4 then "rare" else "capture")
		end
	elseif kind == "fade" then
		burst(position, EFFECT_COLORS.fade, 10, 5)
	else
		burst(position + Vector3.new(0, 2, 0), EFFECT_COLORS[kind] or Color3.new(1, 1, 1), 24, 14)
		if near then
			WorldEffects.playSound(if kind == "collect" then "collect" else "build")
		end
	end
end

--------------------------------------------------------------------------
-- Owner-only prompts
--------------------------------------------------------------------------
local function watchPrompt(prompt: ProximityPrompt)
	if not prompt:GetAttribute("OwnerOnly") then
		return
	end
	local function apply()
		local isOwner = prompt:GetAttribute("OwnerUserId") == player.UserId
		prompt.Enabled = isOwner and prompt:GetAttribute("ServerEnabled") ~= false
	end
	apply()
	prompt:GetAttributeChangedSignal("OwnerUserId"):Connect(apply)
	prompt:GetAttributeChangedSignal("ServerEnabled"):Connect(apply)
end

--------------------------------------------------------------------------
-- Room ghost bobbing
--------------------------------------------------------------------------
local bobbing: { [Model]: { Base: CFrame, Phase: number } } = {}

local function trackRoomGhost(instance: Instance)
	if instance:IsA("Model") then
		bobbing[instance] = { Base = instance:GetPivot(), Phase = math.random() * math.pi * 2 }
	end
end

--------------------------------------------------------------------------
-- Mini ghosts orbiting players who carry ghosts
--------------------------------------------------------------------------
local minis: { [Player]: { Key: string, Models: { Model } } } = {}

local function rebuildMinis(owner: Player, key: string)
	local entry = minis[owner]
	if entry then
		for _, model in entry.Models do
			model:Destroy()
		end
	end
	local models = {}
	if key ~= "" then
		for index, item in string.split(key, ",") do
			if index > MAX_MINIS then
				break
			end
			local parts = string.split(item, ":")
			local ghostId = parts[1]
			local mutation = if parts[2] and parts[2] ~= "" then parts[2] else nil
			if Config.GhostsById[ghostId] then
				local model = GhostFactory.build(ghostId, mutation, { Scale = 0.32, Billboard = false, Light = false })
				model.Parent = effectsFolder
				table.insert(models, model)
			end
		end
	end
	minis[owner] = { Key = key, Models = models }
end

local function updateMinis(now: number)
	for _, owner in Players:GetPlayers() do
		local key = owner:GetAttribute("BackpackIds") or ""
		local entry = minis[owner]
		if not entry or entry.Key ~= key then
			rebuildMinis(owner, key)
			entry = minis[owner]
		end
		local character = owner.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local count = #entry.Models
		for index, model in entry.Models do
			if root then
				local angle = now * 1.6 + index * (math.pi * 2 / count)
				local offset =
					Vector3.new(math.cos(angle) * 3.2, 1.2 + math.sin(now * 3 + index) * 0.35, math.sin(angle) * 3.2)
				model:PivotTo(CFrame.new(root.Position + offset) * CFrame.Angles(0, -angle, 0))
			else
				model:PivotTo(CFrame.new(0, -500, 0))
			end
		end
	end
	for owner, entry in minis do
		if not owner.Parent then
			for _, model in entry.Models do
				model:Destroy()
			end
			minis[owner] = nil
		end
	end
end

--------------------------------------------------------------------------
-- Start
--------------------------------------------------------------------------
function WorldEffects.start()
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	remotes:WaitForChild("Effect").OnClientEvent:Connect(onEffect)

	for _, descendant in Workspace:GetDescendants() do
		if descendant:IsA("ProximityPrompt") then
			watchPrompt(descendant)
		end
	end
	Workspace.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("ProximityPrompt") then
			watchPrompt(descendant)
		end
	end)
	ProximityPromptService.PromptTriggered:Connect(function()
		WorldEffects.playSound("collect")
	end)

	for _, instance in CollectionService:GetTagged("RoomGhost") do
		trackRoomGhost(instance)
	end
	CollectionService:GetInstanceAddedSignal("RoomGhost"):Connect(trackRoomGhost)
	CollectionService:GetInstanceRemovedSignal("RoomGhost"):Connect(function(instance)
		bobbing[instance :: Model] = nil
	end)

	RunService.RenderStepped:Connect(function()
		local now = os.clock()
		local camera = Workspace.CurrentCamera
		local cameraPosition = if camera then camera.CFrame.Position else Vector3.zero

		-- Rainbow mutation
		local rainbow = Color3.fromHSV((now * 0.25) % 1, 0.55, 1)
		for _, part in CollectionService:GetTagged("Rainbow") do
			(part :: BasePart).Color = rainbow
		end
		for _, gradient in CollectionService:GetTagged("RainbowGradient") do
			local uiGradient = (gradient :: Instance):FindFirstChildOfClass("UIGradient")
			if uiGradient then
				uiGradient.Offset = Vector2.new(math.sin(now * 1.5) * 0.4, 0)
			end
		end

		-- Room ghosts gently float
		for model, info in bobbing do
			if not model.Parent then
				bobbing[model] = nil
			elseif (info.Base.Position - cameraPosition).Magnitude < BOB_DISTANCE then
				local lift = math.sin(now * 2 + info.Phase) * 0.35
				local sway = math.sin(now * 0.8 + info.Phase) * 0.25
				model:PivotTo(info.Base * CFrame.new(0, lift, 0) * CFrame.Angles(0, sway, 0))
			end
		end

		updateMinis(now)
	end)

	-- [VIP] chat tag
	TextChatService.OnIncomingMessage = function(message: TextChatMessage)
		local source = message.TextSource
		local speaker = source and Players:GetPlayerByUserId(source.UserId)
		if speaker and speaker:GetAttribute("Pass_VIP") then
			local properties = Instance.new("TextChatMessageProperties")
			properties.PrefixText = '<font color="#FFD34D">[VIP]</font> ' .. message.PrefixText
			return properties
		end
		return nil
	end
end

return WorldEffects
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="TextChatService" referent="33">
    <Properties>
      <string name="Name">TextChatService</string>
    </Properties>
