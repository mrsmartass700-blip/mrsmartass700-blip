      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Player data persistence with a lightweight session lock, so a player who
-- hops servers quickly never loads stale data or gets rolled back.

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Loop = require(script.Parent.Loop)

local STORE_NAME = "GhostHotel_v1"
local AUTOSAVE_INTERVAL = 90
local LOAD_ATTEMPTS = 5
local LOAD_RETRY_DELAY = 6
local STALE_SESSION_SECONDS = 10 * 60
local MAX_PURCHASE_HISTORY = 100

local DEFAULT_DATA = {
	Cash = Config.StartingCash,
	Rebirths = 0,
	Builds = 0,
	UnlockedRooms = Config.StartRooms,
	Rooms = {}, -- ["<room>"] = { Id = ghostId, Mutation = name? }
	Backpack = {}, -- { { Id = ghostId, Mutation = name? } }
	VacuumLevel = 1,
	BackpackLevel = 1,
	Stored = 0, -- cash waiting in the register
	TotalEarned = 0,
	Caught = 0,
	LastOnline = 0,
	Purchases = {}, -- recent developer product PurchaseIds (idempotency)
}

type Profile = {
	Data: any,
	Key: string,
	CanSave: boolean,
	Releasing: boolean,
}

local DataService = {}

local profiles: { [Player]: Profile } = {}

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(STORE_NAME)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStores unavailable:", result)
	end
end

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for key, inner in value do
		copy[key] = deepCopy(inner)
	end
	return copy
end

-- Adds keys that were introduced after the player's data was first saved.
local function reconcile(data: any): any
	for key, default in DEFAULT_DATA do
		if data[key] == nil then
			data[key] = deepCopy(default)
		end
	end
	return data
end

local function keyFor(player: Player): string
	return "player_" .. player.UserId
end

local function studioFallback(player: Player): any
	warn(
		"[DataService] Using temporary data for "
			.. player.Name
			.. " (enable 'Studio Access to API Services' to test saving)."
	)
	local data = deepCopy(DEFAULT_DATA)
	profiles[player] = { Data = data, Key = keyFor(player), CanSave = false, Releasing = false }
	return data
end

-- Loads (and session-locks) the player's data. Yields. Returns nil when the
-- data could not be loaded safely; the caller should kick the player.
function DataService.load(player: Player): any?
	if not store then
		return if RunService:IsStudio() then studioFallback(player) else nil
	end

	local key = keyFor(player)
	for attempt = 1, LOAD_ATTEMPTS do
		local locked = false
		local loaded = nil
		local ok, err = pcall(function()
			(store :: DataStore):UpdateAsync(key, function(stored)
				locked = false
				stored = stored or {}
				local session = stored.Session
				local isForeign = session ~= nil and session.JobId ~= game.JobId
				local isFresh = session ~= nil and os.time() - (session.Time or 0) < STALE_SESSION_SECONDS
				-- On the last attempt we take the lock over: the other server
				-- most likely crashed without releasing it.
				if isForeign and isFresh and attempt < LOAD_ATTEMPTS then
					locked = true
					return nil
				end
				stored.Session = { JobId = game.JobId, Time = os.time() }
				loaded = stored.Data
				return stored
			end)
		end)

		if ok and not locked then
			local data = reconcile(loaded or deepCopy(DEFAULT_DATA))
			profiles[player] = { Data = data, Key = key, CanSave = true, Releasing = false }
			if not player.Parent then
				-- Left while loading: give the session lock straight back.
				task.spawn(DataService.release, player)
				return nil
			end
			return data
		end

		if not player.Parent then
			return nil
		end

		if not ok then
			warn("[DataService] Load attempt", attempt, "failed for", player.Name, err)
			if RunService:IsStudio() then
				return studioFallback(player)
			end
		end
		task.wait(LOAD_RETRY_DELAY)
	end

	return nil
end

function DataService.get(player: Player): any?
	local profile = profiles[player]
	return profile and profile.Data
end

local function write(player: Player, profile: Profile, release: boolean): boolean
	if not profile.CanSave then
		return true
	end
	profile.Data.LastOnline = os.time()

	local lostSession = false
	local ok, err = pcall(function()
		(store :: DataStore):UpdateAsync(profile.Key, function(stored)
			lostSession = false
			stored = stored or {}
			local session = stored.Session
			if session and session.JobId ~= game.JobId then
				lostSession = true
				return nil
			end
			stored.Data = profile.Data
			stored.Session = if release then nil else { JobId = game.JobId, Time = os.time() }
			return stored
		end)
	end)

	if lostSession then
		-- Another server owns this player's data now; never overwrite it.
		profile.CanSave = false
		warn("[DataService] Session for", player.Name, "was taken over; stopped saving here.")
		return false
	end
	if not ok then
		warn("[DataService] Save failed for", player.Name, err)
	end
	return ok
end

function DataService.save(player: Player): boolean
	local profile = profiles[player]
	if not profile or profile.Releasing then
		return false
	end
	return write(player, profile, false)
end

-- Final save + unlock. Call when the player leaves.
function DataService.release(player: Player)
	local profile = profiles[player]
	if not profile or profile.Releasing then
		return
	end
	profile.Releasing = true
	for _ = 1, 3 do
		if write(player, profile, true) then
			break
		end
		task.wait(2)
	end
	profiles[player] = nil
end

-- Remembers a developer product purchase so it is never granted twice.
function DataService.hasPurchase(player: Player, purchaseId: string): boolean
	local data = DataService.get(player)
	return data ~= nil and table.find(data.Purchases, purchaseId) ~= nil
end

function DataService.addPurchase(player: Player, purchaseId: string)
	local data = DataService.get(player)
	if not data then
		return
	end
	table.insert(data.Purchases, purchaseId)
	while #data.Purchases > MAX_PURCHASE_HISTORY do
		table.remove(data.Purchases, 1)
	end
end

function DataService.start()
	Loop.every(AUTOSAVE_INTERVAL, "Autosave", function()
		for player in profiles do
			task.spawn(DataService.save, player)
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				DataService.release(player)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while (pending > 0 or next(profiles) ~= nil) and os.clock() < deadline do
			task.wait(0.2)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">EventService</string>
          <string name="Source"><![CDATA[-- Witching Hour: a server-wide event with boosted rare ghost odds and
-- more spawns. Happens on a timer and can be summoned with Robux.
-- State is mirrored on ReplicatedStorage attributes for the client UI.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local Loop = require(script.Parent.Loop)
local Remotes = require(script.Parent.Remotes)

local EventService = {}

local endsAt = 0
local active = false

local NORMAL = {
	ClockTime = 20.8,
	Ambient = Color3.fromRGB(75, 65, 100),
	OutdoorAmbient = Color3.fromRGB(95, 85, 130),
	Tint = Color3.new(1, 1, 1),
}
local WITCHING = {
	ClockTime = 0,
	Ambient = Color3.fromRGB(110, 50, 120),
	OutdoorAmbient = Color3.fromRGB(140, 60, 150),
	Tint = Color3.fromRGB(255, 205, 235),
}

local function now(): number
	return workspace:GetServerTimeNow()
end

local function applyLighting(preset)
	local info = TweenInfo.new(3, Enum.EasingStyle.Sine)
	TweenService:Create(Lighting, info, {
		ClockTime = preset.ClockTime,
		Ambient = preset.Ambient,
		OutdoorAmbient = preset.OutdoorAmbient,
	}):Play()
	local grading = Lighting:FindFirstChild("Grading")
	if grading then
		TweenService:Create(grading, info, { TintColor = preset.Tint }):Play()
	end
end

local function publish()
	ReplicatedStorage:SetAttribute("WitchingHour", active)
	ReplicatedStorage:SetAttribute("WitchingHourEndsAt", endsAt)
end

function EventService.isActive(): boolean
	return active
end

function EventService.getLuck(): number
	return if active then Config.WitchingHour.Luck else 1
end

function EventService.getSpawnRate(): number
	return if active then Config.WitchingHour.SpawnRate else 1
end

-- Starts the event or extends it when it is already running.
function EventService.start(duration: number, summonedBy: Player?)
	local wasActive = active
	endsAt = math.max(endsAt, now()) + duration
	active = true
	publish()
	if not wasActive then
		applyLighting(WITCHING)
	end
	if summonedBy then
		Remotes.notifyAll("🌕 " .. summonedBy.DisplayName .. " summoned the WITCHING HOUR! Rare ghosts x3!", "event")
	elseif not wasActive then
		Remotes.notifyAll("🌕 The WITCHING HOUR has begun! Rare ghosts x3!", "event")
	end
end

function EventService.run()
	publish()
	local nextNatural = now() + Config.WitchingHour.Every
	Loop.every(1, "WitchingHour", function()
		local time = now()
		if active and time >= endsAt then
			active = false
			publish()
			applyLighting(NORMAL)
			Remotes.notifyAll("☀️ The Witching Hour is over.", "info")
			nextNatural = math.max(nextNatural, time + Config.WitchingHour.Every / 2)
		elseif not active and time >= nextNatural then
			EventService.start(Config.WitchingHour.Duration)
			nextNatural = time + Config.WitchingHour.Every
		end
	end)
end

return EventService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">GhostService</string>
          <string name="Source"><![CDATA[-- Ghost hunting: ghosts spawn and float around the graveyard, players hold
-- the Ghost Vacuum to suck them in. Rarer ghosts take longer to catch and
-- several hunters can fight over the same ghost — first to 100% wins.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local GhostFactory = require(Shared.GhostFactory)
local Odds = require(Shared.Odds)

local EventService = require(script.Parent.EventService)
local HotelService = require(script.Parent.HotelService)
local Loop = require(script.Parent.Loop)
local MapBuilder = require(script.Parent.MapBuilder)
local Remotes = require(script.Parent.Remotes)

type Ghost = {
	Model: Model,
	Root: BasePart,
	Attachment: Attachment,
	Align: AlignPosition,
	Orient: AlignOrientation,
	Id: string,
	Mutation: string?,
	Rarity: number,
	Target: Vector3,
	NextWander: number,
	SpawnedAt: number,
	Phase: number,
	Progress: { [Player]: number },
	PulledBy: Player?,
	Fill: Frame?,
	Bar: Frame?,
	Captured: boolean,
}

type Hunter = {
	Tool: Tool,
	Beam: Beam,
	Active: boolean,
	Target: Ghost?,
	LastFullNotice: number,
}

local GhostService = {}

local TICK = 0.1
local FLOAT_HEIGHT = 3

local ghosts: { Ghost } = {}
local hunters: { [Player]: Hunter } = {}
local rng = Random.new()
local ghostFolder: Folder

--------------------------------------------------------------------------
-- Spawning
--------------------------------------------------------------------------
local function randomGraveyardPoint(): Vector3
	local min, max = MapBuilder.GraveyardMin, MapBuilder.GraveyardMax
	return Vector3.new(rng:NextNumber(min.X + 4, max.X - 4), 0, rng:NextNumber(min.Z + 4, max.Z - 4))
end

local function floatHeight(ghost: Ghost): number
	return FLOAT_HEIGHT + ghost.Root.Size.Y / 2
end

local function pickWanderTarget(ghost: Ghost)
	local min, max = MapBuilder.GraveyardMin, MapBuilder.GraveyardMax
	local current = ghost.Root.Position
	local offset = Vector3.new(rng:NextNumber(-35, 35), 0, rng:NextNumber(-20, 20))
	local target = Vector3.new(
		math.clamp(current.X + offset.X, min.X + 3, max.X - 3),
		floatHeight(ghost) + rng:NextNumber(0, 2.5),
		math.clamp(current.Z + offset.Z, min.Z + 3, max.Z - 3)
	)
	ghost.Target = target
	ghost.NextWander = os.clock() + rng:NextNumber(3, 7)
end

local function spawnGhost()
	local definition = Odds.rollGhost(EventService.getLuck(), rng)
	local mutation = Odds.rollMutation(rng)
	local model = GhostFactory.build(definition.Id, mutation)
	local root = model.PrimaryPart :: BasePart

	local point = randomGraveyardPoint()
	local start = Vector3.new(point.X, FLOAT_HEIGHT + root.Size.Y / 2, point.Z)
	model:PivotTo(CFrame.new(start) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))

	local attachment = Instance.new("Attachment")
	attachment.Name = "GhostAttachment"
	attachment.Parent = root

	local align = Instance.new("AlignPosition")
	align.Mode = Enum.PositionAlignmentMode.OneAttachment
	align.Attachment0 = attachment
	align.Position = start
	align.MaxForce = math.huge
	align.MaxVelocity = Config.Rarities[definition.Rarity].Speed
	align.Responsiveness = 25
	align.Parent = root

	local orient = Instance.new("AlignOrientation")
	orient.Mode = Enum.OrientationAlignmentMode.OneAttachment
	orient.Attachment0 = attachment
	orient.CFrame = root.CFrame.Rotation
	orient.MaxTorque = math.huge
	orient.Responsiveness = 12
	orient.Parent = root

	root.Anchored = false
	model.Parent = ghostFolder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)

	local info = root:FindFirstChild("Info")
	local bar = info and info:FindFirstChild("Progress")

	local ghost: Ghost = {
		Model = model,
		Root = root,
		Attachment = attachment,
		Align = align,
		Orient = orient,
		Id = definition.Id,
		Mutation = mutation,
		Rarity = definition.Rarity,
		Target = start,
		NextWander = 0,
		SpawnedAt = os.clock(),
		Phase = rng:NextNumber(0, math.pi * 2),
		Progress = {},
		PulledBy = nil,
		Bar = bar,
		Fill = bar and bar:FindFirstChild("Fill"),
		Captured = false,
	}
	pickWanderTarget(ghost)
	table.insert(ghosts, ghost)

	if definition.Rarity >= Config.AnnounceFromRarity then
		local rarity = Config.Rarities[definition.Rarity]
		local prefix = if mutation then string.upper(mutation) .. " " else ""
		Remotes.notifyAll(
			string.format(
				"👻 A %s%s %s appeared in the graveyard!",
				prefix,
				string.upper(rarity.Name),
				definition.Name
			),
			"event"
		)
	end
end

local function removeGhost(ghost: Ghost)
	ghost.Captured = true
	local index = table.find(ghosts, ghost)
	if index then
		table.remove(ghosts, index)
	end
	for _, hunter in hunters do
		if hunter.Target == ghost then
			hunter.Target = nil
			hunter.Beam.Attachment1 = nil
			hunter.Beam.Enabled = false
		end
	end
	ghost.Model:Destroy()
end

--------------------------------------------------------------------------
-- The vacuum tool
--------------------------------------------------------------------------
local function weldTo(handle: BasePart, part: BasePart, offset: CFrame)
	part.CFrame = handle.CFrame * offset
	part.Anchored = false
	part.CanCollide = false
	part.Massless = true
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = part
	weld.Parent = part
end

local function createVacuum(): (Tool, Beam)
	local tool = Instance.new("Tool")
	tool.Name = "Ghost Vacuum"
	tool.ToolTip = "Hold to suck up ghosts!"
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	-- Forward is -Z; hold the vacuum near its back end.
	tool.GripPos = Vector3.new(0, 0, 1)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.9, 0.9, 3.4)
	handle.Color = Color3.fromRGB(60, 60, 75)
	handle.Material = Enum.Material.Metal
	handle.CanCollide = false
	handle.Parent = tool

	local tank = Instance.new("Part")
	tank.Name = "Tank"
	tank.Shape = Enum.PartType.Cylinder
	tank.Size = Vector3.new(2, 1.2, 1.2)
	tank.Color = Color3.fromRGB(120, 255, 200)
	tank.Material = Enum.Material.Neon
	tank.Transparency = 0.2
	weldTo(handle, tank, CFrame.new(0, 0.9, 0.5) * CFrame.Angles(0, math.pi / 2, 0))
	tank.Parent = tool

	local nozzle = Instance.new("Part")
	nozzle.Name = "Nozzle"
	nozzle.Shape = Enum.PartType.Cylinder
	nozzle.Size = Vector3.new(0.4, 1.4, 1.4)
	nozzle.Color = Color3.fromRGB(170, 90, 255)
	nozzle.Material = Enum.Material.Neon
	weldTo(handle, nozzle, CFrame.new(0, 0, -1.8) * CFrame.Angles(0, math.pi / 2, 0))
	nozzle.Parent = tool

	local tip = Instance.new("Attachment")
	tip.Name = "Tip"
	tip.Position = Vector3.new(0, 0, -2)
	tip.Parent = handle

	local beam = Instance.new("Beam")
	beam.Name = "VacuumBeam"
	beam.Attachment0 = tip
	beam.Color = ColorSequence.new(Color3.fromRGB(120, 255, 220), Color3.fromRGB(190, 110, 255))
	beam.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 0.55),
	})
	beam.Width0 = 0.8
	beam.Width1 = 3
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.Segments = 12
	beam.Enabled = false
	beam.Parent = handle

	return tool, beam
end

local function giveVacuum(player: Player)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return
	end
	local tool, beam = createVacuum()
	local hunter: Hunter = {
		Tool = tool,
		Beam = beam,
		Active = false,
		Target = nil,
		LastFullNotice = 0,
	}
	tool.Activated:Connect(function()
		hunter.Active = true
	end)
	tool.Deactivated:Connect(function()
		hunter.Active = false
	end)
	tool.Unequipped:Connect(function()
		hunter.Active = false
	end)
	tool.Parent = backpack
	hunters[player] = hunter

	-- Equip it right away so new players immediately know what to do.
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid:EquipTool(tool)
	end
end

--------------------------------------------------------------------------
-- Simulation
--------------------------------------------------------------------------
local function findTarget(root: BasePart): Ghost?
	local best, bestScore = nil, math.huge
	for _, ghost in ghosts do
		if not ghost.Captured then
			local offset = ghost.Root.Position - root.Position
			local distance = offset.Magnitude
			if distance <= Config.VacuumRange and distance > 0 then
				local facing = root.CFrame.LookVector:Dot(offset.Unit)
				local score = distance * (1.6 - facing)
				if score < bestScore then
					best, bestScore = ghost, score
				end
			end
		end
	end
	return best
end

local function capture(ghost: Ghost, player: Player)
	if not HotelService.addToBackpack(player, ghost.Id, ghost.Mutation) then
		ghost.Progress[player] = 0.99
		return
	end
	local definition = Config.GhostsById[ghost.Id]
	local rarity = Config.Rarities[ghost.Rarity]
	local mutationText = if ghost.Mutation then ghost.Mutation .. " " else ""
	Remotes.notify(
		player,
		string.format("👻 Caught %s%s! (%s)", mutationText, definition.Name, rarity.Name),
		if ghost.Rarity >= 4 then "rare" else "success"
	)
	if ghost.Rarity >= Config.AnnounceFromRarity then
		Remotes.notifyAll(
			string.format(
				"🎉 %s caught a %s%s %s!",
				player.DisplayName,
				mutationText,
				string.upper(rarity.Name),
				definition.Name
			),
			"event"
		)
	end
	Remotes.Effect:FireAllClients("capture", ghost.Root.Position, ghost.Rarity)
	removeGhost(ghost)
end

local function stepHunters(dt: number)
	for player, hunter in hunters do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local equipped = hunter.Tool.Parent == character
		local alive = humanoid ~= nil and humanoid.Health > 0

		local target: Ghost? = nil
		if hunter.Active and equipped and alive and root then
			if HotelService.isBackpackFull(player) then
				if os.clock() - hunter.LastFullNotice > 6 then
					hunter.LastFullNotice = os.clock()
					Remotes.notify(player, "🎒 Backpack full! Bring your ghosts to your hotel.", "error")
				end
			else
				target = hunter.Target
				local valid = target ~= nil
					and not target.Captured
					and (target.Root.Position - root.Position).Magnitude <= Config.VacuumRange * 1.25
				if not valid then
					target = findTarget(root)
				end
			end
		end

		hunter.Target = target
		if target and root then
			target.PulledBy = player
			local rarity = Config.Rarities[target.Rarity]
			local gain = dt * HotelService.getVacuumPower(player) / rarity.CaptureTime
			target.Progress[player] = (target.Progress[player] or 0) + gain
			hunter.Beam.Attachment1 = target.Attachment
			hunter.Beam.Enabled = true
			if target.Progress[player] >= 1 then
				capture(target, player)
			end
		elseif hunter.Beam.Enabled then
			hunter.Beam.Enabled = false
			hunter.Beam.Attachment1 = nil
		end
	end
end

local function stepGhosts(dt: number)
	local now = os.clock()
	for index = #ghosts, 1, -1 do
		local ghost = ghosts[index]
		local root = ghost.Root
		if not root.Parent then
			table.remove(ghosts, index)
			continue
		end

		-- Decay progress from hunters who stopped vacuuming this ghost.
		local best = 0
		for player, progress in ghost.Progress do
			local hunter = hunters[player]
			if not hunter or hunter.Target ~= ghost then
				progress -= Config.ProgressDecay * dt
				ghost.Progress[player] = if progress > 0 then progress else nil
			end
			best = math.max(best, ghost.Progress[player] or 0)
		end
		if ghost.Bar and ghost.Fill then
			ghost.Bar.Visible = best > 0
			ghost.Fill.Size = UDim2.fromScale(math.clamp(best, 0, 1), 1)
		end

		local puller = ghost.PulledBy
		local pullerHunter = puller and hunters[puller]
		local pullerRoot = puller
			and puller.Character
			and puller.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local position = root.Position

		local toHunter = if pullerRoot then pullerRoot.Position - position else Vector3.zero
		if pullerHunter and pullerHunter.Target == ghost and pullerRoot and toHunter.Magnitude > 0.1 then
			-- Being vacuumed: drift toward the hunter and wobble.
			local stop = pullerRoot.Position - toHunter.Unit * 6
			ghost.Align.Position = Vector3.new(stop.X, pullerRoot.Position.Y + 2, stop.Z)
			ghost.Align.MaxVelocity = Config.VacuumPullSpeed
			local shake = CFrame.Angles(0, 0, math.sin(now * 30) * 0.25)
			ghost.Orient.CFrame = CFrame.lookAt(
				position,
				Vector3.new(pullerRoot.Position.X, position.Y, pullerRoot.Position.Z)
			).Rotation * shake
		else
			ghost.PulledBy = nil
			if now - ghost.SpawnedAt > Config.GhostLifetime and next(ghost.Progress) == nil then
				Remotes.Effect:FireAllClients("fade", position, ghost.Rarity)
				removeGhost(ghost)
				continue
			end
			local flat = Vector3.new(ghost.Target.X - position.X, 0, ghost.Target.Z - position.Z)
			if flat.Magnitude < 3 or now > ghost.NextWander then
				pickWanderTarget(ghost)
				flat = Vector3.new(ghost.Target.X - position.X, 0, ghost.Target.Z - position.Z)
			end
			local bob = math.sin(now * 2 + ghost.Phase) * 0.8
			ghost.Align.Position = ghost.Target + Vector3.new(0, bob, 0)
			ghost.Align.MaxVelocity = Config.Rarities[ghost.Rarity].Speed
			if flat.Magnitude > 0.5 then
				ghost.Orient.CFrame = CFrame.lookAt(Vector3.zero, flat.Unit)
			end
		end
	end
end

--------------------------------------------------------------------------
-- Startup
--------------------------------------------------------------------------
function GhostService.onCharacterAdded(player: Player, character: Model)
	local old = hunters[player]
	if old then
		old.Tool:Destroy()
		hunters[player] = nil
	end
	character:WaitForChild("Humanoid", 10)
	if player.Character == character then
		giveVacuum(player)
	end
end

function GhostService.onPlayerRemoving(player: Player)
	hunters[player] = nil
	for _, ghost in ghosts do
		ghost.Progress[player] = nil
		if ghost.PulledBy == player then
			ghost.PulledBy = nil
		end
	end
end

function GhostService.start()
	ghostFolder = Instance.new("Folder")
	ghostFolder.Name = "Ghosts"
	ghostFolder.Parent = workspace

	Loop.every(TICK, "Hunters", stepHunters)
	Loop.every(TICK, "Ghosts", stepGhosts)

	local spawnTimer = 0
	Loop.every(TICK, "Spawner", function(dt)
		spawnTimer += dt
		local interval = Config.SpawnInterval / EventService.getSpawnRate()
		local cap = Config.MaxGhosts * (if EventService.isActive() then 1.5 else 1)
		if spawnTimer >= interval then
			spawnTimer = 0
			if #ghosts < cap and #Players:GetPlayers() > 0 then
				spawnGhost()
			end
		end
	end)
end

return GhostService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">HotelService</string>
          <string name="Source"><![CDATA[-- The tycoon itself: hotel ownership, rooms, income, the cash register,
-- build buttons, upgrades, the fusion cauldron, rebirths and player stats.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)
local GhostFactory = require(Shared.GhostFactory)

local DataService = require(script.Parent.DataService)
local Loop = require(script.Parent.Loop)
local MapBuilder = require(script.Parent.MapBuilder)
local PassCache = require(script.Parent.PassCache)
local Remotes = require(script.Parent.Remotes)

type Plot = MapBuilder.Plot

type State = {
	Data: any,
	Plot: Plot,
	RoomModels: { [number]: Model },
	Income: number,
	Multiplier: number,
	LastCollect: number,
	LastBuild: number,
	LastFullWarning: number,
	LastTeleport: number,
}

local HotelService = {}

local plots: { Plot } = {}
local states: { [Player]: State } = {}

local ROOM_GHOST_MAX_SIZE = 4.6
local COLOR_OPEN = Color3.fromRGB(90, 255, 220)
local COLOR_NEXT = Color3.fromRGB(255, 255, 255)
local COLOR_LOCKED = Color3.fromRGB(70, 70, 80)
local COLOR_VIP = Color3.fromRGB(255, 200, 60)

--------------------------------------------------------------------------
-- Helpers
--------------------------------------------------------------------------
local function playerFromHit(hit: BasePart): Player?
	local character = hit:FindFirstAncestorOfClass("Model")
	return character and Players:GetPlayerFromCharacter(character)
end

local function makePrompt(
	parent: Instance,
	action: string,
	object: string,
	hold: number,
	owner: Player?
): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.HoldDuration = hold
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Style = Enum.ProximityPromptStyle.Default
	-- The client hides owner-only prompts from everybody else.
	prompt:SetAttribute("OwnerOnly", true)
	prompt:SetAttribute("OwnerUserId", if owner then owner.UserId else 0)
	prompt.Parent = parent
	return prompt
end

local function clearPrompts(parent: Instance)
	for _, child in parent:GetChildren() do
		if child:IsA("ProximityPrompt") then
			child:Destroy()
		end
	end
end

local function isOwner(player: Player, plot: Plot): boolean
	return plot.Owner == player and states[player] ~= nil
end

local function effect(player: Player?, kind: string, position: Vector3)
	if player then
		Remotes.Effect:FireClient(player, kind, position)
	else
		Remotes.Effect:FireAllClients(kind, position)
	end
end

--------------------------------------------------------------------------
-- Stats
--------------------------------------------------------------------------
function HotelService.getStats(player: Player): Formulas.Stats
	local state = states[player]
	return {
		Rebirths = if state then state.Data.Rebirths else 0,
		Builds = if state then state.Data.Builds else 0,
		DoubleCash = PassCache.owns(player, "DoubleCash"),
		VIP = PassCache.owns(player, "VIP"),
		Premium = PassCache.isPremium(player),
	}
end

function HotelService.getIncomePerSecond(player: Player): number
	local state = states[player]
	return if state then state.Income else 0
end

function HotelService.getVacuumPower(player: Player): number
	local state = states[player]
	if not state then
		return 1
	end
	return Formulas.vacuumPower(state.Data.VacuumLevel, state.Data.Rebirths, PassCache.owns(player, "MegaVacuum"))
end

function HotelService.getBackpackCapacity(player: Player): number
	local state = states[player]
	if not state then
		return 0
	end
	return Formulas.backpackCapacity(state.Data.BackpackLevel, PassCache.owns(player, "BigBackpack"))
end

function HotelService.isBackpackFull(player: Player): boolean
	local state = states[player]
	return state == nil or #state.Data.Backpack >= HotelService.getBackpackCapacity(player)
end

function HotelService.getPlot(player: Player): Plot?
	local state = states[player]
	return state and state.Plot
end

function HotelService.isLoaded(player: Player): boolean
	return states[player] ~= nil
end

local function backpackString(data): string
	local parts = {}
	for _, ghost in data.Backpack do
		table.insert(parts, ghost.Id .. ":" .. (ghost.Mutation or ""))
	end
	return table.concat(parts, ",")
end

local function updateLeaderstats(player: Player, data)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		return
	end
	leaderstats.Cash.Value = Format.money(data.Cash)
	leaderstats.Ghosts.Value = data.Caught
	leaderstats.Rebirths.Value = data.Rebirths
end

local function updateCashAttributes(player: Player, data)
	player:SetAttribute("Cash", data.Cash)
	player:SetAttribute("Stored", math.floor(data.Stored))
	updateLeaderstats(player, data)
end

local function applyWalkSpeed(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = if PassCache.owns(player, "SpeedCoil") then Config.SpeedCoilWalkSpeed else Config.WalkSpeed
	end
end

--------------------------------------------------------------------------
-- Money
--------------------------------------------------------------------------
function HotelService.addCash(player: Player, amount: number)
	local state = states[player]
	if not state or amount <= 0 then
		return
	end
	state.Data.Cash += amount
	updateCashAttributes(player, state.Data)
end

function HotelService.trySpend(player: Player, amount: number): boolean
	local state = states[player]
	if not state then
		return false
	end
	if state.Data.Cash < amount then
		Remotes.notify(
			player,
			"Not enough cash! You need " .. Format.money(amount - state.Data.Cash) .. " more.",
			"error"
		)
		return false
	end
	state.Data.Cash -= amount
	updateCashAttributes(player, state.Data)
	return true
end

--------------------------------------------------------------------------
-- Plot visuals
--------------------------------------------------------------------------
local function updateStations(player: Player)
	local state = states[player]
	if not state then
		return
	end
	local data, plot = state.Data, state.Plot

	for kind, upgrade in Config.Upgrades do
		local level = if kind == "Vacuum" then data.VacuumLevel else data.BackpackLevel
		local cost = Formulas.upgradeCost(kind, level)
		local stat = if kind == "Vacuum"
			then "Power x" .. string.format("%.2f", HotelService.getVacuumPower(player))
			else "Holds " .. HotelService.getBackpackCapacity(player) .. " ghosts"
		local nextText = if cost then "Upgrade: " .. Format.money(cost) else "MAX LEVEL"
		plot.StationLabels[kind].Text = string.format(
			'%s %s <font color="#9fe0ff">Lv %d</font>\n<font size="18">%s • %s</font>',
			upgrade.Icon,
			upgrade.Name,
			level,
			stat,
			nextText
		)
		local prompt = plot.Stations[kind]:FindFirstChildOfClass("ProximityPrompt")
		if prompt then
			prompt.ObjectText = if cost then Format.money(cost) else "MAX"
			-- Visibility is decided on the client (owner only), see WorldEffects.
			prompt:SetAttribute("ServerEnabled", cost ~= nil)
		end
	end

	plot.StationLabels.Cauldron.Text = '🧪 Fusion Cauldron\n<font size="18">3 identical ghosts → 1 mutated</font>'

	local nextBuild = Config.HotelBuilds[data.Builds + 1]
	plot.BuildLabel.Text = if nextBuild
		then string.format(
			'🔨 Build: %s\n<font color="#7dff9b">%s</font> <font size="18">(+%d%% income)</font>',
			nextBuild.Name,
			Format.money(nextBuild.Price),
			math.floor(nextBuild.IncomeBonus * 100 + 0.5)
		)
		else "🏆 Hotel complete!"
	plot.BuildPad.Transparency = if nextBuild then 0 else 0.7
end

local function updateRegister(player: Player)
	local state = states[player]
	if not state then
		return
	end
	state.Plot.RegisterLabel.Text = string.format(
		'💰 %s\n<font size="18">Step here to collect</font>',
		Format.money(math.floor(state.Data.Stored))
	)
end

local function roomGhostCFrame(plot: Plot, room: number, ghostId: string, scale: number): CFrame
	local size = GhostFactory.getSize(ghostId, scale)
	return plot.Rooms[room].GhostCFrame * CFrame.new(0, 1.6 + size / 2, 0)
end

local function renderRoom(player: Player, room: number)
	local state = states[player]
	if not state then
		return
	end
	local data, plot = state.Data, state.Plot
	local info = plot.Rooms[room]

	local old = state.RoomModels[room]
	if old then
		old:Destroy()
		state.RoomModels[room] = nil
	end
	clearPrompts(info.Base)

	local entry = data.Rooms[tostring(room)]
	local vip = PassCache.owns(player, "VIP")
	local isVipRoom = Formulas.isVipRoom(room)
	local open = Formulas.isRoomOpen(room, data.UnlockedRooms, vip)

	if entry and Config.GhostsById[entry.Id] then
		local scale = math.min(1, ROOM_GHOST_MAX_SIZE / GhostFactory.getSize(entry.Id))
		local model = GhostFactory.build(entry.Id, entry.Mutation, { Scale = scale })
		model:PivotTo(roomGhostCFrame(plot, room, entry.Id, scale))
		model:SetAttribute("OwnerUserId", player.UserId)
		model:SetAttribute("Room", room)
		model:AddTag("RoomGhost")

		local value = Formulas.releaseValue(entry.Id, entry.Mutation, state.Multiplier)
		local prompt = makePrompt(model.PrimaryPart :: BasePart, "Release", "+" .. Format.money(value), 0.8, player)
		prompt.Triggered:Connect(function(who)
			if who == player then
				HotelService.releaseGhost(player, room)
			end
		end)

		model.Parent = plot.Model
		state.RoomModels[room] = model
		info.Ring.Color = Config.Rarities[Config.GhostsById[entry.Id].Rarity].Color
		info.Label.Text = ""
	elseif open then
		info.Ring.Color = if isVipRoom then COLOR_VIP else COLOR_OPEN
		info.Label.Text = if isVipRoom then "👑 VIP room\nEmpty" else "Empty room"
	elseif isVipRoom then
		info.Ring.Color = COLOR_VIP
		info.Label.Text = '👑 VIP ROOM\n<font size="16">Get the VIP pass</font>'
	elseif room == Formulas.nextLockedRoom(data.UnlockedRooms) then
		local cost = Formulas.roomCost(data.UnlockedRooms) or 0
		info.Ring.Color = COLOR_NEXT
		info.Label.Text = "🔒 Unlock\n" .. Format.money(cost)
		local prompt = makePrompt(info.Base, "Unlock Room", Format.money(cost), 0.3, player)
		prompt.Triggered:Connect(function(who)
			if who == player then
				HotelService.unlockRoom(player)
			end
		end)
	else
		info.Ring.Color = COLOR_LOCKED
		info.Label.Text = "🔒"
	end
end

local function renderAllRooms(player: Player)
	for room = 1, Formulas.TotalRooms do
		renderRoom(player, room)
	end
end

local function setBuildVisible(plot: Plot, key: string, visible: boolean, animate: boolean)
	local model = plot.Builds[key]
	if not model then
		return
	end
	if not visible then
		model.Parent = nil
		return
	end
	if model.Parent == plot.Model then
		return
	end
	model.Parent = plot.Model
	if animate then
		for _, descendant in model:GetDescendants() do
			if descendant:IsA("BasePart") then
				local target = descendant.CFrame
				descendant.CFrame = target * CFrame.new(0, -4, 0)
				TweenService:Create(descendant, TweenInfo.new(0.7, Enum.EasingStyle.Back), { CFrame = target }):Play()
			end
		end
	end
end

local function renderBuilds(player: Player, animateLatest: boolean)
	local state = states[player]
	if not state then
		return
	end
	for index, build in Config.HotelBuilds do
		local owned = index <= state.Data.Builds
		setBuildVisible(state.Plot, build.Key, owned, animateLatest and index == state.Data.Builds)
	end
end

--------------------------------------------------------------------------
-- Refresh: recompute derived stats and push them to the client
--------------------------------------------------------------------------
function HotelService.refresh(player: Player)
	local state = states[player]
	if not state then
		return
	end
	local data = state.Data
	state.Multiplier = Formulas.incomeMultiplier(HotelService.getStats(player))

	local income = 0
	for _, entry in data.Rooms do
		income += Formulas.ghostIncome(entry.Id, entry.Mutation)
	end
	state.Income = income * state.Multiplier

	player:SetAttribute("IncomePerSec", state.Income)
	player:SetAttribute("Multiplier", state.Multiplier)
	player:SetAttribute("Rebirths", data.Rebirths)
	player:SetAttribute("Builds", data.Builds)
	player:SetAttribute("Caught", data.Caught)
	player:SetAttribute("VacuumLevel", data.VacuumLevel)
	player:SetAttribute("BackpackLevel", data.BackpackLevel)
	player:SetAttribute("VacuumPower", HotelService.getVacuumPower(player))
	player:SetAttribute("BackpackCount", #data.Backpack)
	player:SetAttribute("BackpackCapacity", HotelService.getBackpackCapacity(player))
	player:SetAttribute("BackpackIds", backpackString(data))
	updateCashAttributes(player, data)

	-- Release prices depend on the multiplier, keep the prompts in sync.
	for room, model in state.RoomModels do
		local entry = data.Rooms[tostring(room)]
		local prompt = model.PrimaryPart and model.PrimaryPart:FindFirstChildOfClass("ProximityPrompt")
		if entry and prompt then
			prompt.ObjectText = "+" .. Format.money(Formulas.releaseValue(entry.Id, entry.Mutation, state.Multiplier))
		end
	end
	updateStations(player)
	updateRegister(player)
	applyWalkSpeed(player)

	local stars = data.Builds
	state.Plot.SignLabel.Text = player.DisplayName .. "'s Hotel"
	state.Plot.StarsLabel.Text = string.rep("★", stars) .. string.rep("☆", #Config.HotelBuilds - stars)
end

--------------------------------------------------------------------------
-- Gameplay actions
--------------------------------------------------------------------------
local function freeRooms(player: Player): { number }
	local state = states[player]
	local free = {}
	if not state then
		return free
	end
	local vip = PassCache.owns(player, "VIP")
	local order = table.clone(Formulas.RoomOrder)
	for room = 1, Formulas.TotalRooms do
		if Formulas.isVipRoom(room) then
			table.insert(order, room)
		end
	end
	for _, room in order do
		if Formulas.isRoomOpen(room, state.Data.UnlockedRooms, vip) and state.Data.Rooms[tostring(room)] == nil then
			table.insert(free, room)
		end
	end
	return free
end

-- Adds a freshly caught ghost to the player's backpack.
function HotelService.addToBackpack(player: Player, ghostId: string, mutation: string?): boolean
	local state = states[player]
	if not state or HotelService.isBackpackFull(player) then
		return false
	end
	table.insert(state.Data.Backpack, { Id = ghostId, Mutation = mutation })
	state.Data.Caught += 1
	HotelService.refresh(player)
	return true
end

-- Moves ghosts from the backpack into free rooms.
function HotelService.checkIn(player: Player)
	local state = states[player]
	if not state or #state.Data.Backpack == 0 then
		return
	end
	local free = freeRooms(player)
	local count = 0
	while #state.Data.Backpack > 0 and #free > 0 do
		local ghost = table.remove(state.Data.Backpack, 1)
		local room = table.remove(free, 1) :: number
		state.Data.Rooms[tostring(room)] = { Id = ghost.Id, Mutation = ghost.Mutation }
		renderRoom(player, room)
		count += 1
	end
	if count > 0 then
		HotelService.refresh(player)
		Remotes.notify(
			player,
			"🏨 Checked in " .. count .. " ghost" .. (if count > 1 then "s" else "") .. "!",
			"success"
		)
		effect(player, "checkin", state.Plot.Register.Position)
	end
	if #state.Data.Backpack > 0 and os.clock() - state.LastFullWarning > 12 then
		state.LastFullWarning = os.clock()
		Remotes.notify(player, "Your hotel is full! Unlock rooms or release ghosts.", "error")
	end
end

function HotelService.releaseGhost(player: Player, room: number)
	local state = states[player]
	if not state then
		return
	end
	local entry = state.Data.Rooms[tostring(room)]
	if not entry then
		return
	end
	local value = Formulas.releaseValue(entry.Id, entry.Mutation, state.Multiplier)
	state.Data.Rooms[tostring(room)] = nil
	state.Data.Cash += value
	renderRoom(player, room)
	HotelService.refresh(player)
	Remotes.notify(
		player,
		"👋 Released " .. Config.GhostsById[entry.Id].Name .. " for +" .. Format.money(value),
		"success"
	)
	effect(player, "release", state.Plot.Rooms[room].Base.Position)
end

function HotelService.unlockRoom(player: Player)
	local state = states[player]
	if not state then
		return
	end
	local cost = Formulas.roomCost(state.Data.UnlockedRooms)
	if not cost or not HotelService.trySpend(player, cost) then
		return
	end
	state.Data.UnlockedRooms += 1
	renderAllRooms(player)
	HotelService.refresh(player)
	Remotes.notify(player, "🔓 New room unlocked!", "success")
	effect(player, "build", state.Plot.Register.Position)
	HotelService.checkIn(player)
end

function HotelService.upgrade(player: Player, kind: string)
	local state = states[player]
	if not state then
		return
	end
	local field = if kind == "Vacuum" then "VacuumLevel" else "BackpackLevel"
	local cost = Formulas.upgradeCost(kind, state.Data[field])
	if not cost or not HotelService.trySpend(player, cost) then
		return
	end
	state.Data[field] += 1
	HotelService.refresh(player)
	Remotes.notify(
		player,
		Config.Upgrades[kind].Icon .. " " .. kind .. " upgraded to level " .. state.Data[field] .. "!",
		"success"
	)
	effect(player, "build", state.Plot.Stations[kind].Position)
end

function HotelService.buyNextBuild(player: Player)
	local state = states[player]
	if not state or os.clock() - state.LastBuild < 1 then
		return
	end
	local build = Config.HotelBuilds[state.Data.Builds + 1]
	if not build then
		return
	end
	state.LastBuild = os.clock()
	if not HotelService.trySpend(player, build.Price) then
		return
	end
	state.Data.Builds += 1
	renderBuilds(player, true)
	HotelService.refresh(player)
	Remotes.notify(
		player,
		string.format("🔨 Built %s! Income +%d%%", build.Name, math.floor(build.IncomeBonus * 100 + 0.5)),
		"success"
	)
	effect(player, "build", state.Plot.BuildPad.Position)
end

function HotelService.fuse(player: Player)
	local state = states[player]
	if not state then
		return
	end
	local groups: { [string]: { number } } = {}
	for key, entry in state.Data.Rooms do
		if Formulas.nextMutation(entry.Mutation) then
			local groupKey = entry.Id .. "|" .. (entry.Mutation or "")
			groups[groupKey] = groups[groupKey] or {}
			table.insert(groups[groupKey], tonumber(key) :: number)
		end
	end

	local bestRooms, bestIncome = nil, -1
	for _, rooms in groups do
		if #rooms >= Config.FuseCount then
			local entry = state.Data.Rooms[tostring(rooms[1])]
			local income = Formulas.ghostIncome(entry.Id, Formulas.nextMutation(entry.Mutation))
			if income > bestIncome then
				bestRooms, bestIncome = rooms, income
			end
		end
	end

	if not bestRooms then
		Remotes.notify(
			player,
			"🧪 Put " .. Config.FuseCount .. " identical ghosts (same mutation) in your rooms to fuse!",
			"error"
		)
		return
	end

	table.sort(bestRooms)
	local first = state.Data.Rooms[tostring(bestRooms[1])]
	local result = { Id = first.Id, Mutation = Formulas.nextMutation(first.Mutation) }
	for index = 1, Config.FuseCount do
		state.Data.Rooms[tostring(bestRooms[index])] = nil
	end
	state.Data.Rooms[tostring(bestRooms[1])] = result
	for index = 1, Config.FuseCount do
		renderRoom(player, bestRooms[index])
	end
	HotelService.refresh(player)
	Remotes.notify(
		player,
		string.format("🧪 Fused into a %s %s!", string.upper(result.Mutation), Config.GhostsById[result.Id].Name),
		"success"
	)
	effect(player, "fuse", state.Plot.Stations.Cauldron.Position)
end

function HotelService.collect(player: Player)
	local state = states[player]
	if not state or os.clock() - state.LastCollect < 0.5 then
		return
	end
	local amount = math.floor(state.Data.Stored)
	if amount < 1 then
		return
	end
	state.LastCollect = os.clock()
	state.Data.Stored -= amount
	state.Data.Cash += amount
	updateCashAttributes(player, state.Data)
	updateRegister(player)
	effect(player, "collect", state.Plot.Register.Position)
end

function HotelService.rebirth(player: Player)
	local state = states[player]
	if not state then
		return
	end
	local data = state.Data
	local cost = Formulas.rebirthCost(data.Rebirths)
	if data.Cash < cost then
		Remotes.notify(player, "You need " .. Format.money(cost) .. " to rebirth.", "error")
		return
	end
	data.Rebirths += 1
	data.Cash = Config.Rebirth.StartCash
	data.Stored = 0
	data.Builds = 0
	data.UnlockedRooms = Config.StartRooms
	data.Rooms = {}
	data.Backpack = {}
	data.VacuumLevel = 1
	data.BackpackLevel = 1
	renderBuilds(player, false)
	renderAllRooms(player)
	HotelService.refresh(player)
	Remotes.notifyAll("♻️ " .. player.DisplayName .. " rebirthed! (Rebirth " .. data.Rebirths .. ")", "event")
	effect(nil, "rebirth", state.Plot.Register.Position)
	task.spawn(DataService.save, player)
end

function HotelService.teleportHome(player: Player)
	local state = states[player]
	local character = player.Character
	if not state or not character or os.clock() - state.LastTeleport < Config.HomeTeleportCooldown then
		return
	end
	state.LastTeleport = os.clock()
	character:PivotTo(state.Plot.SpawnCFrame)
end

--------------------------------------------------------------------------
-- Player lifecycle
--------------------------------------------------------------------------
function HotelService.assign(player: Player): Plot?
	for _, plot in plots do
		if plot.Owner == nil then
			plot.Owner = player
			return plot
		end
	end
	return nil
end

function HotelService.setup(player: Player, plot: Plot, data)
	local state: State = {
		Data = data,
		Plot = plot,
		RoomModels = {},
		Income = 0,
		Multiplier = 1,
		LastCollect = 0,
		LastBuild = 0,
		LastFullWarning = 0,
		LastTeleport = 0,
	}
	states[player] = state
	plot.Owner = player
	plot.Model:SetAttribute("OwnerUserId", player.UserId)
	for _, station in plot.Stations do
		local prompt = station:FindFirstChildOfClass("ProximityPrompt")
		if prompt then
			prompt:SetAttribute("OwnerUserId", player.UserId)
		end
	end

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	local cash = Instance.new("StringValue")
	cash.Name = "Cash"
	cash.Parent = leaderstats
	local ghosts = Instance.new("IntValue")
	ghosts.Name = "Ghosts"
	ghosts.Parent = leaderstats
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = leaderstats
	leaderstats.Parent = player

	-- Drop anything that no longer exists in the config.
	for key, entry in data.Rooms do
		if not Config.GhostsById[entry.Id] then
			data.Rooms[key] = nil
		end
	end
	for index = #data.Backpack, 1, -1 do
		if not Config.GhostsById[data.Backpack[index].Id] then
			table.remove(data.Backpack, index)
		end
	end

	HotelService.refresh(player)
	renderBuilds(player, false)
	renderAllRooms(player)

	-- Offline earnings
	if data.LastOnline > 0 and state.Income > 0 then
		local away = math.min(os.time() - data.LastOnline, Config.OfflineEarningsMaxSeconds)
		local earned = math.floor(state.Income * math.max(away, 0) * Config.OfflineEarningsRate)
		if earned > 0 then
			data.Cash += earned
			updateCashAttributes(player, data)
			task.delay(3, function()
				if player.Parent then
					Remotes.notify(
						player,
						"🌙 Your ghosts earned " .. Format.money(earned) .. " while you were away!",
						"success"
					)
				end
			end)
		end
	end

	player:SetAttribute("PlotIndex", plot.Index)
	player:SetAttribute("Loaded", true)
end

function HotelService.cleanup(player: Player)
	local state = states[player]
	for _, plot in plots do
		if plot.Owner == player then
			plot.Owner = nil
		end
	end
	if not state then
		return
	end
	local plot = state.Plot
	for _, model in state.RoomModels do
		model:Destroy()
	end
	for room = 1, Formulas.TotalRooms do
		local info = plot.Rooms[room]
		clearPrompts(info.Base)
		info.Ring.Color = COLOR_LOCKED
		info.Label.Text = ""
	end
	for key in plot.Builds do
		setBuildVisible(plot, key, false, false)
	end
	for key, label in plot.StationLabels do
		label.Text = ""
		local prompt = plot.Stations[key]:FindFirstChildOfClass("ProximityPrompt")
		if prompt then
			prompt:SetAttribute("OwnerUserId", 0)
		end
	end
	plot.Model:SetAttribute("OwnerUserId", 0)
	plot.SignLabel.Text = "Empty Hotel"
	plot.StarsLabel.Text = ""
	plot.RegisterLabel.Text = ""
	plot.BuildLabel.Text = ""
	states[player] = nil
end

function HotelService.onCharacterAdded(player: Player, character: Model)
	local state = states[player]
	if not state then
		return
	end
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if root and states[player] == state then
		task.defer(function()
			character:PivotTo(state.Plot.SpawnCFrame)
		end)
	end
	applyWalkSpeed(player)
end

--------------------------------------------------------------------------
-- Startup
--------------------------------------------------------------------------
local function ownerTouch(part: BasePart, plotRef: Plot, callback: (Player) -> ())
	part.Touched:Connect(function(hit)
		local player = playerFromHit(hit)
		if player and isOwner(player, plotRef) then
			callback(player)
		end
	end)
end

function HotelService.init(builtPlots: { Plot })
	plots = builtPlots
	for _, plot in plots do
		ownerTouch(plot.Register, plot, HotelService.collect)
		ownerTouch(plot.BuildPad, plot, HotelService.buyNextBuild)

		for kind in Config.Upgrades do
			local prompt = makePrompt(plot.Stations[kind], "Upgrade " .. kind, "", 0.3, nil)
			prompt.Triggered:Connect(function(player)
				if isOwner(player, plot) then
					HotelService.upgrade(player, kind)
				end
			end)
		end
		local fusePrompt = makePrompt(plot.Stations.Cauldron, "Fuse Ghosts", "3 → 1", 1, nil)
		fusePrompt.Triggered:Connect(function(player)
			if isOwner(player, plot) then
				HotelService.fuse(player)
			end
		end)
	end
end

function HotelService.start()
	PassCache.Changed:Connect(function(player)
		if states[player] then
			renderAllRooms(player)
			HotelService.refresh(player)
			HotelService.checkIn(player)
		end
	end)

	Remotes.Rebirth.OnServerEvent:Connect(HotelService.rebirth)
	Remotes.TeleportHome.OnServerEvent:Connect(HotelService.teleportHome)

	-- Income tick
	Loop.every(1, "Income", function()
		for player, state in states do
			if state.Income > 0 then
				state.Data.Stored += state.Income
				state.Data.TotalEarned += state.Income
				player:SetAttribute("Stored", math.floor(state.Data.Stored))
				updateRegister(player)
			end
		end
	end)

	-- Automatically check ghosts in when their hunter walks into the hotel.
	Loop.every(0.5, "CheckIn", function()
		for player, state in states do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root and #state.Data.Backpack > 0 and MapBuilder.isInside(state.Plot, (root :: BasePart).Position) then
				HotelService.checkIn(player)
			end
		end
	end)
end

return HotelService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Loop</string>
          <string name="Source"><![CDATA[-- Runs a function on an interval forever. An error in one tick is logged
-- and the loop keeps going, so one bad frame can never stop the game.

local Loop = {}

function Loop.every(interval: number, name: string, callback: (dt: number) -> ())
	task.spawn(function()
		local lastWarning = 0
		while true do
			local dt = task.wait(interval)
			local ok, err = pcall(callback, dt)
			if not ok and os.clock() - lastWarning > 10 then
				lastWarning = os.clock()
				warn("[Loop:" .. name .. "] " .. tostring(err))
			end
		end
	end)
end

return Loop
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="16">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Server entry point: builds the world, starts every service and runs the
-- player lifecycle (load data -> assign hotel -> spawn -> save on leave).

local Players = game:GetService("Players")

local Services = script.Parent
local DataService = require(Services.DataService)
local EventService = require(Services.EventService)
local GhostService = require(Services.GhostService)
local HotelService = require(Services.HotelService)
local MapBuilder = require(Services.MapBuilder)
local MonetizationService = require(Services.MonetizationService)
local PassCache = require(Services.PassCache)

Players.CharacterAutoLoads = false

local plots = MapBuilder.build()
HotelService.init(plots)

DataService.start()
PassCache.start()
EventService.run()
HotelService.start()
GhostService.start()
MonetizationService.start()

local function onCharacterAdded(player: Player, character: Model)
	HotelService.onCharacterAdded(player, character)
	GhostService.onCharacterAdded(player, character)

	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if humanoid then
		humanoid.Died:Connect(function()
			task.wait(3)
			if player.Parent and player.Character == character then
				player:LoadCharacter()
			end
		end)
	end
end

local function onPlayerAdded(player: Player)
	local plot = HotelService.assign(player)
	if not plot then
		player:Kick("This server is full. Please join another server!")
		return
	end

	PassCache.load(player)
	local data = DataService.load(player)
	if not player.Parent then
		HotelService.cleanup(player)
		return
	end
	if not data then
		HotelService.cleanup(player)
		player:Kick("Your data could not be loaded. Please rejoin in a minute!")
		return
	end

	HotelService.setup(player, plot, data)

	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	player:LoadCharacter()
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	GhostService.onPlayerRemoving(player)
	HotelService.cleanup(player)
	DataService.release(player)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[-- Builds the whole world out of parts at server start: the haunted
-- graveyard in the middle and one hotel plot per player around it.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Formulas = require(ReplicatedStorage.Shared.Formulas)

local MapBuilder = {}

-- Layout -------------------------------------------------------------------
local PLOT_WIDTH = 50
local PLOT_DEPTH = 64
local PLOT_ENTRANCE_Z = 40 -- distance from the centre line to a plot's entrance
local PLOT_X = { -84, -28, 28, 84 }
local FLOOR_TOP = 0.5
local ROOM_ROW_X = 17
local ROOM_FIRST_DEPTH = 11
local ROOM_SPACING = 6.8

MapBuilder.GraveyardMin = Vector3.new(-110, 0, -32)
MapBuilder.GraveyardMax = Vector3.new(110, 0, 32)

-- Palette -----------------------------------------------------------------
local COLORS = {
	Ground = Color3.fromRGB(38, 52, 40),
	Dirt = Color3.fromRGB(58, 48, 44),
	Stone = Color3.fromRGB(95, 92, 105),
	DarkStone = Color3.fromRGB(55, 52, 64),
	Wood = Color3.fromRGB(70, 48, 38),
	Floor = Color3.fromRGB(60, 45, 70),
	Purple = Color3.fromRGB(170, 90, 255),
	Green = Color3.fromRGB(110, 255, 140),
	Orange = Color3.fromRGB(255, 140, 40),
	Gold = Color3.fromRGB(255, 200, 60),
	Locked = Color3.fromRGB(120, 120, 130),
}
MapBuilder.Colors = COLORS

export type Room = {
	Index: number,
	Base: BasePart,
	Ring: BasePart,
	Label: TextLabel,
	GhostCFrame: CFrame,
}

export type Plot = {
	Index: number,
	Model: Model,
	Origin: CFrame,
	SpawnCFrame: CFrame,
	Rooms: { Room },
	Register: BasePart,
	RegisterLabel: TextLabel,
	BuildPad: BasePart,
	BuildLabel: TextLabel,
	Stations: { [string]: BasePart },
	StationLabels: { [string]: TextLabel },
	SignLabel: TextLabel,
	StarsLabel: TextLabel,
	Builds: { [string]: Model },
	Owner: Player?,
}

-- Helpers -----------------------------------------------------------------
local function part(props: { [string]: any }): BasePart
	local instance = Instance.new(props.ClassName or "Part")
	instance.Anchored = true
	instance.TopSurface = Enum.SurfaceType.Smooth
	instance.BottomSurface = Enum.SurfaceType.Smooth
	instance.Material = Enum.Material.SmoothPlastic
	for key, value in props do
		if key ~= "ClassName" and key ~= "Parent" then
			(instance :: any)[key] = value
		end
	end
	instance.Parent = props.Parent
	return instance
end

local VERTICAL = CFrame.Angles(0, 0, math.pi / 2)

local function cylinder(
	parent: Instance,
	name: string,
	cframe: CFrame,
	height: number,
	diameter: number,
	color: Color3,
	material: Enum.Material?
): BasePart
	return part({
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, diameter, diameter),
		CFrame = cframe * VERTICAL,
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
		Parent = parent,
	})
end

local function light(parent: Instance, color: Color3, range: number, brightness: number?)
	local pointLight = Instance.new("PointLight")
	pointLight.Color = color
	pointLight.Range = range
	pointLight.Brightness = brightness or 1.5
	pointLight.Shadows = false
	pointLight.Parent = parent
end

local function billboard(
	adornee: BasePart,
	size: UDim2,
	offset: Vector3,
	maxDistance: number?
): (BillboardGui, TextLabel)
	local gui = Instance.new("BillboardGui")
	gui.Size = size
	gui.StudsOffset = offset
	gui.MaxDistance = maxDistance or 90
	gui.LightInfluence = 0
	gui.ResetOnSpawn = false
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.15
	label.RichText = true
	label.Text = ""
	label.Parent = gui
	gui.Parent = adornee
	return gui, label
end

-- Lighting ----------------------------------------------------------------
local function setupLighting()
	Lighting.ClockTime = 20.8
	Lighting.Brightness = 1.6
	Lighting.Ambient = Color3.fromRGB(75, 65, 100)
	Lighting.OutdoorAmbient = Color3.fromRGB(95, 85, 130)
	Lighting.EnvironmentDiffuseScale = 0.4
	Lighting.EnvironmentSpecularScale = 0.4
	Lighting.GlobalShadows = true

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.32
	atmosphere.Offset = 0.1
	atmosphere.Color = Color3.fromRGB(120, 95, 170)
	atmosphere.Decay = Color3.fromRGB(60, 40, 95)
	atmosphere.Glare = 0
	atmosphere.Haze = 1.6
	atmosphere.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.7
	bloom.Size = 28
	bloom.Threshold = 1.4
	bloom.Parent = Lighting

	local grading = Instance.new("ColorCorrectionEffect")
	grading.Name = "Grading"
	grading.Saturation = 0.15
	grading.Contrast = 0.05
	grading.Parent = Lighting
end

-- Graveyard ---------------------------------------------------------------
local function tombstone(parent: Instance, position: Vector3, rng: Random)
	local height = rng:NextNumber(2.6, 4)
	local angle = CFrame.Angles(0, rng:NextNumber(-0.25, 0.25), rng:NextNumber(-0.08, 0.08))
	local base = CFrame.new(position) * angle
	part({
		Name = "Tombstone",
		Size = Vector3.new(2.6, height, 0.7),
		CFrame = base * CFrame.new(0, height / 2, 0),
		Color = COLORS.Stone,
		Material = Enum.Material.Slate,
		Parent = parent,
	})
	cylinder(
		parent,
		"TombTop",
		base * CFrame.new(0, height, 0) * CFrame.Angles(0, math.pi / 2, math.pi / 2),
		0.7,
		2.6,
		COLORS.Stone,
		Enum.Material.Slate
	)
	part({
		Name = "Grave",
		Size = Vector3.new(3, 0.3, 5),
		CFrame = base * CFrame.new(0, 0.15, 3),
		Color = COLORS.Dirt,
		Material = Enum.Material.Ground,
		Parent = parent,
	})
end

local function deadTree(parent: Instance, position: Vector3, rng: Random)
	local height = rng:NextNumber(10, 16)
	local base = CFrame.new(position) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
	cylinder(parent, "Trunk", base * CFrame.new(0, height / 2, 0), height, 1.6, COLORS.Wood, Enum.Material.Wood)
	for index = 1, 4 do
		local y = height * (0.45 + index * 0.12)
		local length = rng:NextNumber(3, 6)
		local branch = CFrame.new(position + Vector3.new(0, y, 0))
			* CFrame.Angles(0, index * 1.7 + rng:NextNumber(0, 0.5), 0)
			* CFrame.Angles(0, 0, math.rad(rng:NextNumber(35, 60)))
			* CFrame.new(0, length / 2, 0)
		cylinder(parent, "Branch", branch, length, 0.6, COLORS.Wood, Enum.Material.Wood)
	end
end

local function pumpkin(parent: Instance, position: Vector3, size: number)
	local body = part({
		Name = "Pumpkin",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * size,
		CFrame = CFrame.new(position + Vector3.new(0, size * 0.4, 0)),
		Color = COLORS.Orange,
		Parent = parent,
	})
	cylinder(
		parent,
		"Stem",
		CFrame.new(body.CFrame.Position + Vector3.new(0, size * 0.5, 0)),
		size * 0.3,
		size * 0.15,
		Color3.fromRGB(80, 130, 50)
	)
	for _, side in { -1, 1 } do
		part({
			Name = "Eye",
			Size = Vector3.new(size * 0.18, size * 0.18, 0.1),
			CFrame = CFrame.new(body.CFrame.Position + Vector3.new(side * size * 0.18, size * 0.1, -size * 0.47)),
			Color = Color3.fromRGB(255, 220, 90),
			Material = Enum.Material.Neon,
			Parent = parent,
		})
	end
	light(body, Color3.fromRGB(255, 160, 60), size * 3, 1.2)
end

local function lampPost(parent: Instance, position: Vector3, color: Color3)
	cylinder(
		parent,
		"Pole",
		CFrame.new(position + Vector3.new(0, 4, 0)),
		8,
		0.5,
		Color3.fromRGB(35, 30, 40),
		Enum.Material.Metal
	)
	local bulb = part({
		Name = "Lamp",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 1.4,
		CFrame = CFrame.new(position + Vector3.new(0, 8.4, 0)),
		Color = color,
		Material = Enum.Material.Neon,
		CanCollide = false,
		Parent = parent,
	})
	light(bulb, color, 18, 1.6)
end

local function buildGraveyard(world: Instance)
	local folder = Instance.new("Folder")
	folder.Name = "Graveyard"
	folder.Parent = world

	local size = MapBuilder.GraveyardMax - MapBuilder.GraveyardMin
	part({
		Name = "GraveyardGround",
		Size = Vector3.new(size.X + 8, 0.2, size.Z + 8),
		CFrame = CFrame.new(Vector3.new(0, 0.1, 0)),
		Color = Color3.fromRGB(45, 55, 45),
		Material = Enum.Material.Grass,
		Parent = folder,
	})

	local rng = Random.new(2026)
	local function freeSpot(): Vector3
		for _ = 1, 30 do
			local x = rng:NextNumber(MapBuilder.GraveyardMin.X + 6, MapBuilder.GraveyardMax.X - 6)
			local z = rng:NextNumber(MapBuilder.GraveyardMin.Z + 6, MapBuilder.GraveyardMax.Z - 6)
			local nearPath = math.abs(z) < 4
			local nearEntrance = false
			for _, plotX in PLOT_X do
				if math.abs(x - plotX) < 10 and math.abs(z) > 20 then
					nearEntrance = true
				end
			end
			if not nearPath and not nearEntrance and Vector2.new(x, z).Magnitude > 14 then
				return Vector3.new(x, 0.2, z)
			end
		end
		return Vector3.new(0, 0.2, 20)
	end

	for _ = 1, 30 do
		tombstone(folder, freeSpot(), rng)
	end
	for _ = 1, 10 do
		deadTree(folder, freeSpot(), rng)
	end
	for _ = 1, 16 do
		pumpkin(folder, freeSpot(), rng:NextNumber(1.6, 3))
	end

	-- Main path with lamps
	part({
		Name = "Path",
		Size = Vector3.new(size.X, 0.25, 6),
		CFrame = CFrame.new(Vector3.new(0, 0.15, 0)),
		Color = COLORS.Dirt,
		Material = Enum.Material.Cobblestone,
		Parent = folder,
	})
	for x = -100, 100, 25 do
		lampPost(folder, Vector3.new(x, 0.2, 4), COLORS.Green)
		lampPost(folder, Vector3.new(x, 0.2, -4), COLORS.Purple)
	end

	-- Central haunted gate (spawn point)
	for _, side in { -1, 1 } do
		part({
			Name = "GatePillar",
			Size = Vector3.new(2.5, 14, 2.5),
			CFrame = CFrame.new(Vector3.new(side * 9, 7, 0)),
			Color = COLORS.DarkStone,
			Material = Enum.Material.Slate,
			Parent = folder,
		})
		local orb = part({
			Name = "GateOrb",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 2.4,
			CFrame = CFrame.new(Vector3.new(side * 9, 15.2, 0)),
			Color = COLORS.Purple,
			Material = Enum.Material.Neon,
			Parent = folder,
		})
		light(orb, COLORS.Purple, 24, 2)
	end
	local arch = part({
		Name = "GateArch",
		Size = Vector3.new(20.5, 2, 2.5),
		CFrame = CFrame.new(Vector3.new(0, 13, 0)),
		Color = COLORS.DarkStone,
		Material = Enum.Material.Slate,
		Parent = folder,
	})
	local _, gateLabel = billboard(arch, UDim2.fromOffset(420, 90), Vector3.new(0, 4, 0), 250)
	gateLabel.Text = "👻 " .. string.upper(Config.GameName) .. " 👻"
	gateLabel.TextColor3 = Color3.fromRGB(200, 160, 255)

	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "GraveyardSpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(8, 0.4, 8)
	spawn.CFrame = CFrame.new(0, 0.3, 0)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Parent = folder
end

-- Hotel builds (the tycoon buttons) ---------------------------------------
local function buildHotelBuilds(at: (number, number, number) -> CFrame): { [string]: Model }
	local builds = {}
	local function newBuild(key: string): Model
		local model = Instance.new("Model")
		model.Name = "Build_" .. key
		builds[key] = model
		return model
	end

	-- 1. Fence
	do
		local model = newBuild("Fence")
		local function fence(x: number, depth: number, width: number, length: number)
			part({
				Name = "Fence",
				Size = Vector3.new(width, 3, length),
				CFrame = at(x, 1.5, depth),
				Color = COLORS.Wood,
				Material = Enum.Material.WoodPlanks,
				Parent = model,
			})
		end
		local half = PLOT_WIDTH / 2
		fence(-half + 0.4, PLOT_DEPTH / 2, 0.8, PLOT_DEPTH)
		fence(half - 0.4, PLOT_DEPTH / 2, 0.8, PLOT_DEPTH)
		fence(0, PLOT_DEPTH - 0.4, PLOT_WIDTH, 0.8)
		fence(-(half + 8) / 2, 0.4, half - 8, 0.8)
		fence((half + 8) / 2, 0.4, half - 8, 0.8)
		for depth = 0, PLOT_DEPTH, 16 do
			for _, x in { -half + 0.4, half - 0.4 } do
				part({
					Name = "Post",
					Size = Vector3.new(1.4, 4.4, 1.4),
					CFrame = at(x, 2.2, math.clamp(depth, 0.7, PLOT_DEPTH - 0.7)),
					Color = COLORS.DarkStone,
					Material = Enum.Material.Slate,
					Parent = model,
				})
			end
		end
	end

	-- 2. Lamps
	do
		local model = newBuild("Lamps")
		for _, depth in { 6, 32, 58 } do
			for _, x in { -22, 22 } do
				local position = at(x, 0, depth).Position
				lampPost(model, position, if x < 0 then COLORS.Purple else COLORS.Green)
			end
		end
	end

	-- 3. Neon sign arch over the entrance
	do
		local model = newBuild("Sign")
		for _, x in { -8.5, 8.5 } do
			part({
				Name = "SignPillar",
				Size = Vector3.new(1.6, 14, 1.6),
				CFrame = at(x, 7, 0.4),
				Color = COLORS.DarkStone,
				Material = Enum.Material.Slate,
				Parent = model,
			})
		end
		local board = part({
			Name = "SignBoard",
			Size = Vector3.new(19, 3.6, 0.8),
			CFrame = at(0, 14.5, 0.4),
			Color = Color3.fromRGB(30, 20, 40),
			Parent = model,
		})
		local surface = Instance.new("SurfaceGui")
		surface.Face = Enum.NormalId.Back
		surface.LightInfluence = 0
		surface.PixelsPerStud = 40
		local text = Instance.new("TextLabel")
		text.BackgroundTransparency = 1
		text.Size = UDim2.fromScale(1, 1)
		text.Font = Enum.Font.FredokaOne
		text.TextScaled = true
		text.Text = "✦ GHOST HOTEL ✦"
		text.TextColor3 = Color3.fromRGB(255, 120, 255)
		text.Parent = surface
		surface.Parent = board
		local tube = part({
			Name = "SignNeon",
			Size = Vector3.new(19.4, 0.3, 0.3),
			CFrame = at(0, 12.6, 0.2),
			Color = Color3.fromRGB(255, 120, 255),
			Material = Enum.Material.Neon,
			Parent = model,
		})
		light(tube, Color3.fromRGB(255, 120, 255), 20, 2)
	end

	-- 4. Red carpet
	do
		local model = newBuild("Carpet")
		part({
			Name = "Carpet",
			Size = Vector3.new(7, 0.1, PLOT_DEPTH - 8),
			CFrame = at(0, 0.05, (PLOT_DEPTH - 8) / 2),
			Color = Color3.fromRGB(170, 25, 45),
			Material = Enum.Material.Fabric,
			CanCollide = false,
			Parent = model,
		})
		for _, x in { -3.6, 3.6 } do
			part({
				Name = "CarpetTrim",
				Size = Vector3.new(0.25, 0.12, PLOT_DEPTH - 8),
				CFrame = at(x, 0.06, (PLOT_DEPTH - 8) / 2),
				Color = COLORS.Gold,
				Material = Enum.Material.Neon,
				CanCollide = false,
				Parent = model,
			})
		end
	end

	-- 5. Slime fountain
	do
		local model = newBuild("Fountain")
		local center = at(0, 0, 33)
		cylinder(model, "Basin", center * CFrame.new(0, 0.75, 0), 1.5, 9, COLORS.Stone, Enum.Material.Slate)
		cylinder(model, "Slime", center * CFrame.new(0, 1.55, 0), 0.2, 8, COLORS.Green, Enum.Material.Neon)
		cylinder(model, "Spout", center * CFrame.new(0, 3, 0), 3.5, 1.4, COLORS.Stone, Enum.Material.Slate)
		local top = part({
			Name = "SpoutOrb",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 2,
			CFrame = center * CFrame.new(0, 5.2, 0),
			Color = COLORS.Green,
			Material = Enum.Material.Neon,
			Parent = model,
		})
		light(top, COLORS.Green, 22, 2)
		local particles = Instance.new("ParticleEmitter")
		particles.Color = ColorSequence.new(COLORS.Green)
		particles.LightEmission = 1
		particles.Rate = 20
		particles.Speed = NumberRange.new(4, 7)
		particles.SpreadAngle = Vector2.new(25, 25)
		particles.Lifetime = NumberRange.new(0.8, 1.2)
		particles.Acceleration = Vector3.new(0, -12, 0)
		particles.Size = NumberSequence.new(0.4, 0.1)
		particles.Parent = top
	end

	-- 6. Haunted tower (back left corner)
	do
		local model = newBuild("Tower")
		local base = at(-20, 0, 60)
		part({
			Name = "Tower",
			Size = Vector3.new(7, 24, 7),
			CFrame = base * CFrame.new(0, 12, 0),
			Color = COLORS.DarkStone,
			Material = Enum.Material.Slate,
			Parent = model,
		})
		for index, size in { 8.5, 6.5, 4.5, 2 } do
			part({
				Name = "Roof",
				Size = Vector3.new(size, 2, size),
				CFrame = base * CFrame.new(0, 24 + index * 2 - 1, 0),
				Color = Color3.fromRGB(80, 40, 110),
				Material = Enum.Material.Slate,
				Parent = model,
			})
		end
		for _, y in { 8, 14, 20 } do
			local window = part({
				Name = "Window",
				Size = Vector3.new(2, 2.6, 0.2),
				CFrame = base * CFrame.new(0, y, 3.55),
				Color = Color3.fromRGB(255, 220, 110),
				Material = Enum.Material.Neon,
				Parent = model,
			})
			light(window, Color3.fromRGB(255, 200, 100), 14, 1)
		end
	end

	-- 7. Pumpkin garden (back right corner)
	do
		local model = newBuild("Garden")
		local base = at(20, 0, 60)
		part({
			Name = "Soil",
			Size = Vector3.new(7, 0.4, 7),
			CFrame = base * CFrame.new(0, 0.2, 0),
			Color = COLORS.Dirt,
			Material = Enum.Material.Ground,
			Parent = model,
		})
		for index = 0, 5 do
			local offset = Vector3.new(-2.2 + (index % 3) * 2.2, 0.4, -1.4 + (index // 3) * 2.8)
			pumpkin(model, (base * CFrame.new(offset)).Position, if index == 4 then 2.6 else 1.8)
		end
	end

	-- 8. Blood moon beacon floating high above the hotel
	do
		local model = newBuild("Moon")
		local moon = part({
			Name = "BloodMoon",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 14,
			CFrame = at(0, 60, 32),
			Color = Color3.fromRGB(255, 50, 60),
			Material = Enum.Material.Neon,
			CanCollide = false,
			Parent = model,
		})
		light(moon, Color3.fromRGB(255, 60, 70), 60, 3)
		local beam = cylinder(model, "MoonBeam", at(0, 30, 32), 58, 3, Color3.fromRGB(255, 80, 90), Enum.Material.Neon)
		beam.Transparency = 0.7
		beam.CanCollide = false
	end

	return builds
end

-- Plots -------------------------------------------------------------------
local function buildPlot(world: Instance, index: number, xCenter: number, side: number): Plot
	-- Looks away from the graveyard, into the plot (+Z for side 1, -Z for side -1).
	local origin = CFrame.new(xCenter, FLOOR_TOP, side * PLOT_ENTRANCE_Z)
		* CFrame.Angles(0, if side == 1 then math.pi else 0, 0)
	-- x: left/right across the plot, depth: distance from the entrance.
	local function at(x: number, y: number, depth: number): CFrame
		return origin * CFrame.new(x, y, -depth)
	end

	local model = Instance.new("Model")
	model.Name = "Plot" .. index
	model:SetAttribute("PlotIndex", index)

	part({
		Name = "Floor",
		Size = Vector3.new(PLOT_WIDTH, 1, PLOT_DEPTH),
		CFrame = at(0, -0.5, PLOT_DEPTH / 2),
		Color = COLORS.Floor,
		Material = Enum.Material.Slate,
		Parent = model,
	})
	-- Walkway from the graveyard to the entrance
	part({
		Name = "Walkway",
		Size = Vector3.new(10, 0.3, PLOT_ENTRANCE_Z - 30),
		CFrame = at(0, -0.4, -(PLOT_ENTRANCE_Z - 30) / 2),
		Color = COLORS.Dirt,
		Material = Enum.Material.Cobblestone,
		Parent = model,
	})

	-- Owner sign above the entrance
	local signAnchor = part({
		Name = "OwnerSign",
		Size = Vector3.new(1, 1, 1),
		CFrame = at(0, 10, 0),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
		Parent = model,
	})
	local signGui, signLabel = billboard(signAnchor, UDim2.fromOffset(360, 110), Vector3.new(0, 0, 0), 160)
	signLabel.Size = UDim2.fromScale(1, 0.6)
	signLabel.Text = "Empty Hotel"
	local stars = Instance.new("TextLabel")
	stars.Name = "Stars"
	stars.BackgroundTransparency = 1
	stars.Size = UDim2.fromScale(1, 0.4)
	stars.Position = UDim2.fromScale(0, 0.6)
	stars.Font = Enum.Font.FredokaOne
	stars.TextScaled = true
	stars.TextColor3 = COLORS.Gold
	stars.TextStrokeTransparency = 0.2
	stars.Text = ""
	stars.Parent = signGui

	-- Rooms
	local rooms: { Room } = {}
	for room = 1, Formulas.TotalRooms do
		local row = if room <= Config.RoomsPerSide then -1 else 1
		local slot = (room - 1) % Config.RoomsPerSide
		local x = row * ROOM_ROW_X
		local depth = ROOM_FIRST_DEPTH + slot * ROOM_SPACING
		local center = at(x, 0, depth)
		local base = cylinder(
			model,
			"RoomBase" .. room,
			center * CFrame.new(0, 0.5, 0),
			1,
			5.6,
			COLORS.DarkStone,
			Enum.Material.Slate
		)
		local ring = cylinder(
			model,
			"RoomRing" .. room,
			center * CFrame.new(0, 1.05, 0),
			0.15,
			5.9,
			COLORS.Locked,
			Enum.Material.Neon
		)
		ring.CanCollide = false
		local _, label = billboard(base, UDim2.fromOffset(170, 50), Vector3.new(0, 3.2, 0), 60)
		-- Ghosts face the aisle.
		local facing = at(0, 0, depth).Position
		local ghostPosition = center.Position
		local ghostCFrame = CFrame.lookAt(ghostPosition, Vector3.new(facing.X, ghostPosition.Y, facing.Z))
		rooms[room] = {
			Index = room,
			Base = base,
			Ring = ring,
			Label = label,
			GhostCFrame = ghostCFrame,
		}
	end

	-- Cash register (collect pad)
	local register = part({
		Name = "Register",
		Size = Vector3.new(6, 0.4, 6),
		CFrame = at(-7.5, 0.2, 7),
		Color = Color3.fromRGB(60, 200, 110),
		Material = Enum.Material.Neon,
		Parent = model,
	})
	local _, registerLabel = billboard(register, UDim2.fromOffset(240, 70), Vector3.new(0, 4, 0), 80)

	-- Tycoon build button
	local buildPad = part({
		Name = "BuildButton",
		Size = Vector3.new(5, 0.4, 5),
		CFrame = at(7.5, 0.2, 7),
		Color = Color3.fromRGB(80, 170, 255),
		Material = Enum.Material.Neon,
		Parent = model,
	})
	local _, buildLabel = billboard(buildPad, UDim2.fromOffset(260, 80), Vector3.new(0, 4, 0), 80)

	-- Upgrade stations and the cauldron at the back
	local stations = {}
	local stationLabels = {}
	local function station(key: string, x: number, color: Color3)
		local block = part({
			Name = key .. "Station",
			Size = Vector3.new(4, 3, 4),
			CFrame = at(x, 1.5, 59),
			Color = color,
			Material = Enum.Material.Metal,
			Parent = model,
		})
		local glow = part({
			Name = key .. "Glow",
			Size = Vector3.new(4.2, 0.3, 4.2),
			CFrame = at(x, 3.1, 59),
			Color = color,
			Material = Enum.Material.Neon,
			Parent = model,
		})
		light(glow, color, 12, 1.2)
		local _, label = billboard(block, UDim2.fromOffset(230, 80), Vector3.new(0, 5, 0), 70)
		stations[key] = block
		stationLabels[key] = label
	end
	station("Vacuum", -9, Color3.fromRGB(90, 200, 255))
	station("Backpack", 9, Color3.fromRGB(255, 170, 60))

	local cauldronCenter = at(0, 0, 58)
	local pot = cylinder(
		model,
		"CauldronStation",
		cauldronCenter * CFrame.new(0, 1.6, 0),
		3.2,
		5,
		Color3.fromRGB(25, 22, 30),
		Enum.Material.Metal
	)
	local brew = cylinder(
		model,
		"CauldronBrew",
		cauldronCenter * CFrame.new(0, 3.25, 0),
		0.2,
		4.3,
		COLORS.Purple,
		Enum.Material.Neon
	)
	light(brew, COLORS.Purple, 16, 2)
	local bubbles = Instance.new("ParticleEmitter")
	bubbles.Color = ColorSequence.new(COLORS.Purple)
	bubbles.LightEmission = 1
	bubbles.Rate = 8
	bubbles.Speed = NumberRange.new(1, 2)
	bubbles.Lifetime = NumberRange.new(1, 1.6)
	bubbles.Size = NumberSequence.new(0.5, 0)
	bubbles.Parent = brew
	local _, cauldronLabel = billboard(pot, UDim2.fromOffset(230, 80), Vector3.new(0, 5, 0), 70)
	stations.Cauldron = pot
	stationLabels.Cauldron = cauldronLabel

	model.Parent = world

	local plot: Plot = {
		Index = index,
		Model = model,
		Origin = origin,
		SpawnCFrame = at(0, 3, 4) * CFrame.Angles(0, math.pi, 0),
		Rooms = rooms,
		Register = register,
		RegisterLabel = registerLabel,
		BuildPad = buildPad,
		BuildLabel = buildLabel,
		Stations = stations,
		StationLabels = stationLabels,
		SignLabel = signLabel,
		StarsLabel = stars,
		Builds = {},
		Owner = nil,
	}
	plot.Builds = buildHotelBuilds(at)
	return plot
end

-- Is `position` inside the plot's walls?
function MapBuilder.isInside(plot: Plot, position: Vector3): boolean
	local localPosition = plot.Origin:PointToObjectSpace(position)
	local depth = -localPosition.Z
	return math.abs(localPosition.X) <= PLOT_WIDTH / 2
		and depth >= 0
		and depth <= PLOT_DEPTH
		and localPosition.Y > -6
		and localPosition.Y < 60
end

function MapBuilder.build(): { Plot }
	setupLighting()

	local world = Instance.new("Folder")
	world.Name = "World"

	part({
		Name = "Ground",
		Size = Vector3.new(700, 2, 700),
		CFrame = CFrame.new(Vector3.new(0, -1, 0)),
		Color = COLORS.Ground,
		Material = Enum.Material.Grass,
		Parent = world,
	})

	buildGraveyard(world)

	local plots = {}
	for index = 1, Config.MaxPlots do
		local column = (index - 1) % #PLOT_X + 1
		local side = if index <= #PLOT_X then 1 else -1
		plots[index] = buildPlot(world, index, PLOT_X[column], side)
	end

	world.Parent = workspace
	return plots
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">MonetizationService</string>
          <string name="Source"><![CDATA[-- Robux monetization: game passes, developer products (ProcessReceipt) and
-- publishing the resolved IDs for the client shop.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Formulas = require(Shared.Formulas)

local DataService = require(script.Parent.DataService)
local EventService = require(script.Parent.EventService)
local HotelService = require(script.Parent.HotelService)
local PassCache = require(script.Parent.PassCache)
local Remotes = require(script.Parent.Remotes)

local MonetizationService = {}

-- Resolved IDs (config IDs, or looked up by product name).
local productIds: { [string]: number } = {}
local productsById: { [number]: any } = {}

local idsFolder = Instance.new("Configuration")
idsFolder.Name = "MonetizationIds"

local function publishIds()
	for _, pass in Config.GamePasses do
		idsFolder:SetAttribute("Pass_" .. pass.Key, pass.Id)
	end
	for _, product in Config.Products do
		idsFolder:SetAttribute("Product_" .. product.Key, productIds[product.Key] or 0)
	end
end

-- Developer products left at Id = 0 are found by their exact name.
local function resolveProductIds()
	local missing = false
	for _, product in Config.Products do
		if product.Id ~= 0 then
			productIds[product.Key] = product.Id
		else
			missing = true
		end
	end

	if missing then
		local ok, err = pcall(function()
			local pages = MarketplaceService:GetDeveloperProductsAsync()
			while true do
				for _, info in pages:GetCurrentPage() do
					for _, product in Config.Products do
						if product.Id == 0 and info.Name == product.Name then
							productIds[product.Key] = info.ProductId
						end
					end
				end
				if pages.IsFinished then
					break
				end
				pages:AdvanceToNextPageAsync()
			end
		end)
		if not ok then
			warn("[Monetization] Could not list developer products:", err)
		end
	end

	for _, product in Config.Products do
		local id = productIds[product.Key]
		if id and id ~= 0 then
			productsById[id] = product
		else
			warn("[Monetization] Developer product '" .. product.Name .. "' has no ID yet (see README).")
		end
	end
	publishIds()
end

local function grantProduct(player: Player, product): boolean
	if product.Kind == "Cash" then
		local amount = Formulas.cashProductAmount(product, HotelService.getIncomePerSecond(player))
		HotelService.addCash(player, amount)
		Remotes.notify(player, "💰 +" .. Format.money(amount) .. " added. Thank you!", "success")
		return true
	elseif product.Kind == "WitchingHour" then
		EventService.start(product.Duration, player)
		return true
	end
	warn("[Monetization] Unknown product kind", product.Kind)
	return false
end

local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		-- Roblox retries the receipt the next time the player joins.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- Wait for the player's data to finish loading.
	local deadline = os.clock() + 20
	while not HotelService.isLoaded(player) and player.Parent and os.clock() < deadline do
		task.wait(0.5)
	end
	if not HotelService.isLoaded(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local purchaseId = tostring(receipt.PurchaseId)
	if DataService.hasPurchase(player, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	local product = productsById[receipt.ProductId]
	if not product then
		warn("[Monetization] Receipt for unknown product", receipt.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local ok, granted = pcall(grantProduct, player, product)
	if not ok or not granted then
		warn("[Monetization] Failed to grant", product.Name, granted)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	DataService.addPurchase(player, purchaseId)
	-- Only confirm once the grant is safely saved. If the save fails the
	-- receipt is retried, and the recorded PurchaseId prevents a double grant.
	if not DataService.save(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function MonetizationService.start()
	idsFolder.Parent = ReplicatedStorage
	publishIds()
	task.spawn(resolveProductIds)

	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		for _, pass in Config.GamePasses do
			if pass.Id ~= 0 and pass.Id == passId then
				PassCache.grant(player, pass.Key)
				Remotes.notify(player, pass.Icon .. " " .. pass.Name .. " unlocked! Thank you!", "success")
				Remotes.notifyAll("✨ " .. player.DisplayName .. " bought " .. pass.Name .. "!", "event")
			end
		end
	end)
end

return MonetizationService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">PassCache</string>
          <string name="Source"><![CDATA[-- Tracks game pass ownership and Roblox Premium for every player.
-- Ownership is mirrored onto player attributes ("Pass_VIP" = true) so the
-- client UI can read it.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local PassCache = {}

local owned: { [Player]: { [string]: boolean } } = {}
local changed = Instance.new("BindableEvent")

-- Fires (player, passKey?) whenever a player's perks change.
PassCache.Changed = changed.Event

local function set(player: Player, key: string, value: boolean)
	owned[player] = owned[player] or {}
	if owned[player][key] == value then
		return
	end
	owned[player][key] = value
	player:SetAttribute("Pass_" .. key, value)
	changed:Fire(player, key)
end

function PassCache.owns(player: Player, key: string): boolean
	local passes = owned[player]
	return passes ~= nil and passes[key] == true
end

function PassCache.isPremium(player: Player): boolean
	return player.MembershipType == Enum.MembershipType.Premium
end

function PassCache.getPassId(key: string): number
	local pass = Config.GamePassesByKey[key]
	return if pass then pass.Id else 0
end

function PassCache.grant(player: Player, key: string)
	set(player, key, true)
end

-- Checks every configured pass. Yields.
function PassCache.load(player: Player)
	owned[player] = owned[player] or {}
	player:SetAttribute("Premium", PassCache.isPremium(player))
	for _, pass in Config.GamePasses do
		player:SetAttribute("Pass_" .. pass.Key, false)
	end
	for _, pass in Config.GamePasses do
		if pass.Id ~= 0 then
			task.spawn(function()
				local ok, result = pcall(function()
					return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
				end)
				if ok and result and player.Parent then
					set(player, pass.Key, true)
				elseif not ok then
					warn("[PassCache] Could not check pass", pass.Name, result)
				end
			end)
		end
	end
end

function PassCache.start()
	Players.PlayerMembershipChanged:Connect(function(player)
		player:SetAttribute("Premium", PassCache.isPremium(player))
		changed:Fire(player, "Premium")
	end)

	Players.PlayerRemoving:Connect(function(player)
		owned[player] = nil
	end)
end

return PassCache
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[-- Creates every RemoteEvent the client talks through.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local folder = Instance.new("Folder")
folder.Name = "Remotes"

local function event(name: string): RemoteEvent
	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = folder
	return remote
end

local Remotes = {
	-- server -> client: (text, kind?) toast notification
	Notify = event("Notify"),
	-- server -> client: (kind, position) one-shot visual/sound effect
	Effect = event("Effect"),
	-- client -> server: request a rebirth
	Rebirth = event("Rebirth"),
	-- client -> server: teleport back to your hotel
	TeleportHome = event("TeleportHome"),
}

folder.Parent = ReplicatedStorage

function Remotes.notify(player: Player, text: string, kind: string?)
	Remotes.Notify:FireClient(player, text, kind or "info")
end

function Remotes.notifyAll(text: string, kind: string?)
	Remotes.Notify:FireAllClients(text, kind or "info")
end

return Remotes
]]></string>
        </Properties>
      </Item>
    </Item>
